# Optional local override for the OAuth relay used by Google login and
# GitHub App installation flows. Production installs use wrangler.jsonc
# unless this value is overridden in Cloudflare Worker settings.
OAUTH_RELAY_URL=https://auth.yulab.me

# Optional: Hub Connector code exchange endpoint.
# Leave unset for a fully self-hosted installation. When unset, users can
# still paste a connector-issued HTTPS connection URL or structured code.
# Set this only if you want short codes like connect_xxx to work.
#
# HUB_CONNECTOR_DEFAULT_EXCHANGE_URL=

# Optional: managed provider integration (set in Cloudflare Worker settings).
# Leave unset for a fully self-hosted installation.
#
# MANAGED_PROVIDER_CONFIG_URL - URL of a JSON config that overrides the
#   provider link and admin CTA visible in the admin sidebar.
#   When unset, built-in yulab / LINE CTA surfaces are shown without hrefs.
#   Set visible:false in the remote JSON to hide either surface, or set HTTPS
#   URLs to make them clickable.
# MANAGED_PROVIDER_USAGE_ENDPOINT - HTTPS URL to receive usage events (POST).
#   Events are only forwarded when MANAGED_PROVIDER_INSTANCE_ID is also set.
# MANAGED_PROVIDER_INSTANCE_ID - Opaque identifier for this installation,
#   included in every usage event payload.
#
# MANAGED_PROVIDER_CONFIG_URL=
# MANAGED_PROVIDER_USAGE_ENDPOINT=
# MANAGED_PROVIDER_INSTANCE_ID=
