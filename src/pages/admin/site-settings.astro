---
/**
 * /admin/site-settings
 *
 * Site-wide settings — currently the tracking tag IDs (GTM, GA4,
 * Clarity, Meta Pixel) plus a custom HTML block injected into the
 * public LP <head>. Additional site-level settings are configured
 * on this page as they are added.
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import SiteSettingsHub from '../../components/admin/SiteSettingsHub';

export const prerender = false;
---

<AdminLayout title="サイト設定">
  <div class="site-settings-page">
    <header class="page-header">
      <h1>サイト設定</h1>
      <p>サイト全体に関わる設定です。使う項目だけ開いて編集します。</p>
    </header>

    <SiteSettingsHub client:load />
  </div>
</AdminLayout>

<style>
  .site-settings-page {
    --admin-ink: #3f4352;
    --admin-muted: #8b91a1;
    margin: 0 auto;
    max-width: 56rem;
  }

  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-header h1 {
    color: var(--admin-ink);
    font-size: 1.9rem;
    font-weight: 800;
    margin: 0;
  }

  .page-header p {
    color: var(--admin-muted);
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.55;
    margin: 0.55rem 0 0;
  }

  @media (max-width: 768px) {
    .page-header {
      margin-bottom: 1.25rem;
    }

    .page-header h1 {
      font-size: 1.45rem;
    }

    .page-header p {
      font-size: 0.88rem;
    }
  }
</style>
