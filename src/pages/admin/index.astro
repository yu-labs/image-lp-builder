---
/**
 * Admin dashboard (/admin)
 *
 * Shows LP list as cards. If no LPs exist, shows onboarding.
 * Authentication enforced by middleware.
 */

import AdminLayout from '../../layouts/AdminLayout.astro';
import LpCardMenu from '../../components/admin/LpCardMenu';
import TrashSection from '../../components/admin/TrashSection';
import { env } from 'cloudflare:workers';
import { pageQueries, type PageWithDraft } from '../../lib/db';
import { parseContent } from '../../lib/content';
import { statusInfo } from '../../lib/labels';
import { Image as ImageIcon } from 'lucide-react';

export const prerender = false;

const db = env?.DB;
const workspaceId = Astro.locals.workspace_id;

// Pagination
const url = new URL(Astro.request.url);
const page = parseInt(url.searchParams.get('page') ?? '1', 10);
const limit = 20;
const offset = (page - 1) * limit;

const lps: PageWithDraft[] = db
  ? await pageQueries.listAll(db, workspaceId, { limit, offset })
  : [];
const totalCount = db ? await pageQueries.countAll(db, workspaceId) : 0;
const totalPages = Math.max(1, Math.ceil(totalCount / limit));

const hasLPs = lps.length > 0 || totalCount > 0;

---

<AdminLayout title="LP一覧">
  <div class="admin-dashboard">
    <header class="page-header">
      <div class="page-title">
        <h1>LP一覧</h1>
        <p>画像LPの作成・編集・公開をここで管理できます。</p>
      </div>
    </header>

    <div class="lp-grid">
      <a href="/admin/lps/new" class="lp-card create-lp-card">
        <span class="create-icon">+</span>
        <span class="create-title">新しいLPを作る</span>
        <span class="create-description">LP画像をアップして始める</span>
      </a>

      {lps.map((lp) => {
        const content = parseContent(lp.content);
        const thumb = content.meta?.ogImage || content.sections[0]?.image.url;
        const hasThumbnail = Boolean(thumb);
        const src = thumb || '/no-image.svg';
        const displayTitle = lp.title?.trim() || lp.slug;
        const isPublished = lp.status === 'published';
        return (
          <div class="lp-card lp-item-card">
            <div class="lp-card-main">
              <div class="lp-thumbnail">
                {hasThumbnail ? (
                  <>
                    <img
                      src={src}
                      alt={displayTitle}
                      loading="lazy"
                      class="thumbnail-img"
                      onerror={"this.onerror=null;this.classList.add('thumbnail-img-broken');this.nextElementSibling?.removeAttribute('hidden');"}
                    />
                    <div
                      class="thumbnail-empty thumbnail-error-fallback"
                      role="img"
                      aria-label="画像未設定"
                      hidden
                    >
                      <span class="thumbnail-empty-icon">
                        <ImageIcon size={52} strokeWidth={1.4} aria-hidden={true} />
                      </span>
                    </div>
                  </>
                ) : (
                  <div class="thumbnail-empty" role="img" aria-label="画像未設定">
                    <span class="thumbnail-empty-icon">
                      <ImageIcon size={52} strokeWidth={1.4} aria-hidden={true} />
                    </span>
                  </div>
                )}
                <div class="lp-card-actions">
                  <a href={`/admin/lps/${lp.id}`} class="lp-card-action lp-card-action-primary">
                    編集
                  </a>
                  {isPublished && (
                    <a
                      href={`/${lp.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="lp-card-action lp-card-action-public"
                    >
                      <span class="desktop-label">公開ページ</span>
                      <span class="mobile-label">公開ページ</span>
                    </a>
                  )}
                </div>
              </div>
              <div class="lp-info">
                <div class="lp-title">{displayTitle}</div>
                <div class="lp-url">/{lp.slug}</div>
                <div class="lp-meta">
                  <span class={`status status-${lp.status}`}>
                    {statusInfo(lp.status).label}
                  </span>
                </div>
                <div class="lp-mobile-actions">
                  <a href={`/admin/lps/${lp.id}`} class="lp-mobile-action lp-mobile-action-primary">
                    編集
                  </a>
                  {isPublished && (
                    <a
                      href={`/${lp.slug}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="lp-mobile-action lp-mobile-action-public"
                    >
                      公開ページ
                    </a>
                  )}
                </div>
              </div>
            </div>
            <LpCardMenu
              client:load
              lp={{
                id: lp.id,
                slug: lp.slug,
                status: lp.status,
                thumbnail: src,
              }}
            />
          </div>
        );
      })}
    </div>

    {hasLPs && totalPages > 1 && (
      <nav class="pagination">
        {page > 1 && (
          <a href={`?page=${page - 1}`} class="page-link">← 前へ</a>
        )}
        <span class="page-info">
          {page} / {totalPages}
        </span>
        {page < totalPages && (
          <a href={`?page=${page + 1}`} class="page-link">次へ →</a>
        )}
      </nav>
    )}

    <TrashSection client:load />
  </div>
</AdminLayout>

<style>
  .admin-dashboard {
    --admin-primary: #567baf;
    --admin-primary-soft: #edf3fb;
    --admin-ink: #3f4352;
    --admin-muted: #8b91a1;
    --lp-card-height: 252px;
    --lp-info-visual-height: 5.8rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Page header */
  .page-header {
    display: flex;
    justify-content: flex-start;
    align-items: flex-end;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    color: var(--admin-ink);
    font-size: 1.9rem;
    font-weight: 700;
    margin: 0;
  }

  .page-title p {
    color: var(--admin-muted);
    font-size: 0.98rem;
    line-height: 1.55;
    margin: 0.65rem 0 0;
  }

  /* LP grid */
  .lp-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .lp-card {
    background: #ffffff;
    border: 0;
    border-radius: 1rem;
    height: var(--lp-card-height);
    overflow: hidden;
    transition: box-shadow 0.18s ease;
    display: block;
    box-shadow: 0 12px 30px rgba(31, 34, 48, 0.06);
    position: relative;
  }

  .lp-card-main {
    color: inherit;
    display: block;
    height: 100%;
    position: relative;
    overflow: hidden;
    border-radius: inherit;
  }

  .create-lp-card {
    border: 0;
    color: var(--admin-ink);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 12px 30px rgba(31, 34, 48, 0.05);
    transition: background 0.18s ease, box-shadow 0.18s ease, color 0.18s ease;
  }

  .create-icon {
    width: 3.125rem;
    height: 3.125rem;
    border-radius: 50%;
    background: var(--admin-primary);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.85rem;
    line-height: 1;
    font-weight: 500;
    box-shadow: 0 12px 26px rgba(86, 123, 175, 0.2);
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
  }

  .create-title {
    color: var(--admin-primary);
    font-size: 1.1rem;
    font-weight: 700;
    transition: color 0.18s ease;
  }

  .create-description {
    color: var(--admin-muted);
    font-size: 0.925rem;
    line-height: 1.5;
    transition: color 0.18s ease;
  }

  .lp-thumbnail {
    position: relative;
    height: 100%;
    background: #f3f1f7;
    overflow: hidden;
  }

  .lp-card:not(.create-lp-card) {
    position: relative;
  }

  .lp-card-menu-open {
    box-shadow: 0 0 0 2px rgba(86, 123, 175, 0.16),
      0 18px 44px rgba(31, 34, 48, 0.11);
  }

  .thumbnail-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .thumbnail-img-broken {
    display: none;
  }

  .thumbnail-empty {
    align-items: center;
    background:
      radial-gradient(circle at 30% 18%, rgba(255, 255, 255, 0.82), transparent 38%),
      radial-gradient(circle at 78% 24%, rgba(86, 123, 175, 0.08), transparent 30%),
      linear-gradient(135deg, #f8fbff 0%, #edf3fb 100%);
    color: rgba(86, 123, 175, 0.26);
    display: flex;
    height: 100%;
    justify-content: center;
    padding-bottom: var(--lp-info-visual-height);
    text-align: center;
  }

  .thumbnail-error-fallback {
    inset: 0;
    position: absolute;
  }

  .thumbnail-empty-icon {
    align-items: center;
    background: transparent;
    border-radius: 0;
    display: inline-flex;
    height: 4.8rem;
    justify-content: center;
    opacity: 0.72;
    width: 4.8rem;
  }

  .lp-card-actions {
    position: absolute;
    top: 0;
    right: 0;
    bottom: var(--lp-info-visual-height);
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(31, 34, 48, 0.34);
    color: #ffffff;
    opacity: 0;
    backdrop-filter: blur(8px) saturate(1.1);
    transition: opacity 0.2s ease;
    pointer-events: none;
    gap: 0.55rem;
    padding: 1rem;
  }

  .lp-card-action {
    border: 1px solid rgba(255, 255, 255, 0.42);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
    color: #ffffff;
    min-width: 5.6rem;
    padding: 0.62rem 1rem;
    text-align: center;
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1;
    pointer-events: auto;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }

  .lp-card-action:hover {
    background: rgba(255, 255, 255, 0.26);
    border-color: rgba(255, 255, 255, 0.62);
    transform: translateY(-1px);
  }

  .lp-card-action-public {
    background: rgba(86, 123, 175, 0.86);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .mobile-label {
    display: none;
  }

  .lp-mobile-actions {
    display: none;
  }

  .lp-info {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: 1rem 1rem 0 0;
    padding: 1rem 1.1rem 1.15rem;
    background: linear-gradient(
      to top,
      rgba(255, 255, 255, 0.97),
      rgba(255, 255, 255, 0.86)
    );
    backdrop-filter: blur(8px);
    box-shadow: 0 -8px 24px rgba(31, 34, 48, 0.1);
    transition: background 0.18s ease, box-shadow 0.18s ease;
  }

  .lp-title {
    color: var(--admin-ink);
    font-size: 1.04rem;
    font-weight: 700;
    margin-bottom: 0.2rem;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .lp-url {
    color: var(--admin-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .lp-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.78rem;
    color: var(--admin-muted);
    transition: color 0.18s ease;
  }

  .status {
    padding: 0.2rem 0.575rem;
    border-radius: 0.25rem;
    font-weight: 700;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease;
  }

  .status-published {
    background: #e9f8ef;
    border-color: #c9ebd5;
    color: #3f7a52;
  }

  .status-draft {
    background: #fff6db;
    border-color: #f5dfa2;
    color: #9a6f2e;
  }

  .status-preview {
    background: #eef3fb;
    border-color: #c8d5e8;
    color: #567baf;
  }

  .status-archived {
    background: #f2f1f6;
    border-color: #ded9e8;
    color: #747989;
  }

  @media (hover: hover) and (pointer: fine) {
    .lp-card:hover {
      box-shadow: 0 16px 36px rgba(31, 34, 48, 0.08);
    }

    .create-lp-card:hover {
      background: var(--admin-primary);
      color: #ffffff;
      box-shadow: 0 18px 42px rgba(86, 123, 175, 0.2);
    }

    .create-lp-card:hover .create-icon {
      background: rgba(255, 255, 255, 0.2);
      color: #ffffff;
      box-shadow: none;
      outline: 1px solid rgba(255, 255, 255, 0.34);
      outline-offset: -1px;
    }

    .create-lp-card:hover .create-title,
    .create-lp-card:hover .create-description {
      color: #ffffff;
    }

    .lp-item-card:hover .thumbnail-img {
      filter: brightness(0.88);
      transform: scale(1.01);
    }

    .lp-item-card:hover .lp-card-actions {
      opacity: 1;
    }

    :global(.lp-item-card:hover [data-lp-card-menu] > button) {
      color: var(--admin-ink) !important;
    }
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding: 1rem 0;
  }

  .page-link {
    padding: 0.5rem 1rem;
    background: #ffffff;
    border: 0;
    border-radius: 0.5rem;
    color: var(--admin-ink);
    font-size: 0.875rem;
    box-shadow: 0 8px 20px rgba(31, 34, 48, 0.06);
    transition: background 0.15s, box-shadow 0.15s;
  }

  .page-link:hover {
    background: var(--admin-primary-soft);
  }

  .page-info {
    font-size: 0.875rem;
    color: var(--admin-muted);
  }

  @media (max-width: 768px) {
    .admin-dashboard {
      --lp-card-height: auto;
      --lp-info-visual-height: 5.4rem;
    }

    .page-header {
      margin-bottom: 1.25rem;
    }

    .page-header h1 {
      font-size: 1.45rem;
    }

    .page-title p {
      font-size: 0.88rem;
    }

    .lp-grid {
      grid-template-columns: 1fr;
      gap: 0.85rem;
      margin-bottom: 1.25rem;
    }

    .lp-card {
      min-height: 0;
    }

    .lp-card-main {
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      align-items: stretch;
      min-height: 0;
      overflow: hidden;
    }

    .create-lp-card {
      min-height: 132px;
      padding: 1.25rem;
    }

    .create-description {
      max-width: 14rem;
    }

    .lp-thumbnail {
      height: auto;
      min-height: 0;
    }

    .thumbnail-img {
      position: absolute;
      inset: 0;
      height: 100%;
      width: 100%;
    }

    .thumbnail-empty {
      position: absolute;
      inset: 0;
      height: auto;
      padding-bottom: 0;
    }

    .thumbnail-empty-icon {
      height: 3.2rem;
      width: 3.2rem;
    }

    .thumbnail-empty-icon svg {
      height: 36px;
      width: 36px;
    }

    .lp-card-actions {
      display: none;
    }

    .lp-info {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: 0;
      position: static;
      border-radius: 0;
      background: #ffffff;
      box-shadow: none;
      backdrop-filter: none;
      padding: 1.05rem 3.1rem 1.05rem 1rem;
    }

    .lp-mobile-actions {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin-top: 0.85rem;
    }

    .lp-mobile-action {
      align-items: center;
      border-radius: 999px;
      display: inline-flex;
      font-size: 0.78rem;
      font-weight: 800;
      justify-content: center;
      line-height: 1;
      min-height: 2.25rem;
      min-width: 0;
      padding: 0.62rem 1rem;
      text-align: center;
      text-decoration: none;
    }

    .lp-mobile-action-primary {
      background: var(--admin-primary);
      color: #ffffff;
    }

    .lp-mobile-action-public {
      background: #ffffff;
      box-shadow: inset 0 0 0 1px #c8d5e8;
      color: var(--admin-primary);
    }

    .lp-title {
      font-size: 0.98rem;
      margin-bottom: 0.3rem;
      padding-right: 0.2rem;
    }

    .lp-url {
      font-size: 0.72rem;
      margin-bottom: 0.5rem;
    }

    .status {
      padding: 0.18rem 0.52rem;
      font-size: 0.7rem;
    }
  }
</style>
