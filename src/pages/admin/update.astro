---
/**
 * Admin update page (/admin/update)
 *
 * Standalone fallback UI: deliberately does not extend AdminLayout so
 * the update button stays reachable even when a sidebar component or
 * the LP list page throws. Self-hosters who hit a broken main screen
 * can still navigate here and pull the latest release.
 *
 * The version probe is wrapped in try/catch — a GitHub API outage
 * must not blank out the page, since this is the operator's escape
 * hatch when something is already wrong.
 *
 * While a self-update lock is held the middleware redirects every
 * other /admin/* page here. The page reads the lock + installation
 * state server-side, then a small client script polls
 * /api/admin/update/status and /api/version to drive the stage
 * display, progress bar, and completion detection.
 *
 * Auth is enforced by the global middleware (every /admin/* path).
 */

import { env } from 'cloudflare:workers';
import { checkForUpdate, CURRENT_VERSION, type VersionCheck } from '../../lib/version';
import { roleLabel } from '../../lib/labels';
import { readLock, type UpdateLockState } from '../../lib/update-lock';
import { installationQueries } from '../../lib/github-install';

export const prerender = false;

const user = Astro.locals.user;
const workspaceId = Astro.locals.workspace_id;

let update: VersionCheck;
try {
  update = await checkForUpdate();
} catch {
  update = {
    current: CURRENT_VERSION,
    latest: null,
    hasUpdate: false,
    isCritical: false,
    releaseUrl: null,
    releaseName: null,
    releaseBody: null,
    fetchStatus: 'network_error',
  };
}

let lock: UpdateLockState | null = null;
if (env?.RATE_LIMIT) {
  try {
    lock = await readLock(env.RATE_LIMIT, workspaceId);
  } catch (err) {
    console.error('readLock on /admin/update failed:', err);
  }
}

let isInstalled = false;
if (env?.DB) {
  try {
    const row = await installationQueries.get(env.DB, workspaceId);
    isInstalled = !!row;
  } catch (err) {
    console.error('installation lookup on /admin/update failed:', err);
  }
}

const installOk = Astro.url.searchParams.get('install_ok') === '1';
const installError = Astro.url.searchParams.get('install_error');

const lockInProgress = !!lock && lock.stage !== 'failed';
const lockFailed = !!lock && lock.stage === 'failed';
const failedMessage = (
  lock?.errorMessage ?? '不明なエラーが発生しました。'
).replace(/<br\s*\/?>/gi, ' ');

const bootstrap = {
  lock: lock
    ? {
        stage: lock.stage,
        startedAt: lock.startedAt,
        fromVersion: lock.fromVersion,
        errorMessage: lock.errorMessage ?? null,
      }
    : null,
  isInstalled,
  currentVersion: update.current,
};
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>アップデート | Image LP Builder</title>
</head>
<body>
  <div class="update-page">
    <header class="page-header">
      {lockInProgress ? (
        <span class="back-link-disabled">アップデート中は他の管理画面へ移動できません</span>
      ) : (
        <a href="/admin" class="back-link">← 管理画面に戻る</a>
      )}
      {user && (
        <span class="user-info">
          {user.email}
          <span class={`user-role role-${user.role}`}>{roleLabel(user.role)}</span>
        </span>
      )}
    </header>

    <main class="content">
      <h1>アップデート</h1>

      {installOk && (
        <div class="banner banner-success">
          GitHub Appのインストールが完了しました。<br />
          「アップデートを実行」を押すと反映が始まります。
        </div>
      )}
      {installError && (
        <div class="banner banner-error">
          インストールに失敗しました（コード: {installError}）。もう一度「アップデートを実行」からやり直してください。
        </div>
      )}

      <section class="version-card">
        <div class="version-row">
          <span class="version-label">現在のバージョン</span>
          <span class="version-value" id="current-version-display">v{update.current}</span>
        </div>
        <div class="version-row">
          <span class="version-label">最新のバージョン</span>
          <span class="version-value">
            {update.latest
              ? `v${update.latest}`
              : update.fetchStatus === 'no_release'
                ? 'まだ公開されていません'
                : '取得できませんでした'}
          </span>
        </div>
      </section>

      {/* In-progress / failed UI takes priority over hasUpdate / latest checks
          because those checks are stale snapshots from the SSR phase. */}
      {lockInProgress ? (
        <section class="status-card status-in-progress" id="state-in-progress">
          <h2>アップデート中です</h2>
          <p>
            アップデートを反映しています。完了するまでこの画面を開いたままお待ちください。<br />
            ブラウザを閉じても処理は続きますが、完了や失敗の確認ができません。
          </p>

          <ol class="stage-list" id="stage-list">
            <li data-stage="syncing">
              <span class="stage-marker"></span>
              <span class="stage-label">GitHubと同期中</span>
            </li>
            <li data-stage="building">
              <span class="stage-marker"></span>
              <span class="stage-label">Cloudflareでビルド中</span>
            </li>
            <li data-stage="verifying">
              <span class="stage-marker"></span>
              <span class="stage-label">新しいバージョンを確認中</span>
            </li>
          </ol>

          <div class="progress-wrap">
            <div class="progress-bar" id="progress-bar"></div>
          </div>
          <p class="progress-note" id="progress-note">準備中…</p>
        </section>
      ) : lockFailed ? (
        <section class="status-card status-error" id="state-failed">
          <h2>アップデートに失敗しました</h2>
          <p id="failed-message">
            {failedMessage}
          </p>
          <div class="action-area">
            <button type="button" class="update-button" id="dismiss-failed-button">
              閉じる
            </button>
          </div>
        </section>
      ) : update.hasUpdate ? (
        <section class={`status-card ${update.isCritical ? 'status-critical' : 'status-normal'}`}>
          {update.isCritical && (
            <div class="critical-badge">🚨 重要なアップデート</div>
          )}
          <h2>
            {update.isCritical
              ? '至急のアップデートがあります'
              : '新しいバージョンが公開されています'}
          </h2>
          <p>
            {update.isCritical
              ? 'セキュリティまたは重大な問題の修正が含まれます。可能な限り早めに適用してください。'
              : '新機能や改善が含まれます。任意のタイミングで適用してください。'}
          </p>
          {update.releaseBody ? (
            <details class="release-notes">
              <summary>このアップデートの内容を見る</summary>
              <div class="release-body">{update.releaseBody}</div>
            </details>
          ) : null}

          <div class="action-area">
            <button type="button" class="update-button" id="run-update-button">
              アップデートを実行
            </button>
            <p class="action-note">
              {isInstalled ? (
                <>
                  「アップデートを実行」を押すと、GitHubと同期 → Cloudflare再ビルド → 新版確認を自動で行います（2〜5分）。<br />
                  完了まではこの画面を開いたままお待ちください。他の管理画面操作は一時的にできません。
                </>
              ) : (
                <>
                  初回のみGitHub Appのインストール画面を経由します（1クリック）。<br />
                  インストール後、自動でアップデートが始まります。
                </>
              )}
            </p>
          </div>
        </section>
      ) : update.latest ? (
        <section class="status-card status-uptodate">
          <h2>最新の状態です</h2>
          <p>このサイトは最新バージョンで動作しています。</p>
        </section>
      ) : update.fetchStatus === 'no_release' ? (
        <section class="status-card status-uptodate">
          <h2>最新バージョンの情報はまだ公開されていません</h2>
          <p>
            このサイトは現在のバージョン（v{update.current}）で動作しています。
            開発元から新しいバージョンが公開されるとここに表示されます。
          </p>
        </section>
      ) : (
        <section class="status-card status-error">
          <h2>バージョン情報を取得できませんでした</h2>
          <p>
            GitHubへの接続に失敗しています。<br />
            ネットワークを確認の上、
            しばらく待ってから再読み込みしてください。
          </p>
        </section>
      )}
    </main>
  </div>

  <div class="confirm-overlay" id="update-confirm-overlay" hidden>
    <div
      class="confirm-dialog"
      id="update-confirm-dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="update-confirm-title"
    >
      <div class="confirm-badge">確認</div>
      <h2 id="update-confirm-title"></h2>
      <p id="update-confirm-message"></p>
      <div class="confirm-actions">
        <button type="button" class="confirm-cancel" id="update-confirm-cancel">
          キャンセル
        </button>
        <button type="button" class="confirm-submit" id="update-confirm-submit">
          実行する
        </button>
      </div>
    </div>
  </div>

  {/* Bootstrap data for the client script. set:html keeps Astro from
      transforming the JSON, so the embedded value is exactly what the
      script expects. */}
  <script
    is:inline
    type="application/json"
    id="update-bootstrap"
    set:html={JSON.stringify(bootstrap)}
  />

  <script is:inline>
    (function () {
      var bootstrapEl = document.getElementById('update-bootstrap');
      if (!bootstrapEl) return;
      var bootstrap;
      try {
        bootstrap = JSON.parse(bootstrapEl.textContent || '{}');
      } catch (e) {
        return;
      }

      var POLL_INTERVAL_MS = 3000;
      var TARGET_DURATION_MS = 2 * 60 * 1000;
      var SLOW_WARN_MS = 3 * 60 * 1000;
      // BUILD_STUCK_MS triggers an automatic GitHub revert when the
      // build stage has been running this long without /api/version
      // flipping over. Picked at 5 min: typical Workers Builds finish
      // inside 2 min, anything past 4 is almost certainly a build
      // failure or a hung deploy. The hard TIMEOUT_MS below covers
      // the (rare) case where /revert itself takes a while or the
      // customer's GitHub installation has expired.
      var BUILD_STUCK_MS = 5 * 60 * 1000;
      var TIMEOUT_MS = 10 * 60 * 1000;

      var STAGE_NOTES = {
        syncing: 'GitHubのアップストリームから差分を取得しています…',
        building: 'Cloudflareがビルドとデプロイを行っています（1〜3分）…',
        verifying: '新しいバージョンの起動を確認しています…',
      };

      function $(id) {
        return document.getElementById(id);
      }

      function applyStage(stage) {
        var items = document.querySelectorAll('#stage-list li');
        var order = ['syncing', 'building', 'verifying'];
        var idx = order.indexOf(stage);
        items.forEach(function (li, i) {
          li.classList.remove('stage-active', 'stage-done');
          if (i < idx) li.classList.add('stage-done');
          else if (i === idx) li.classList.add('stage-active');
        });
        var note = $('progress-note');
        if (note) {
          note.textContent = STAGE_NOTES[stage] || '処理中…';
        }
      }

      function updateProgressBar(elapsedMs) {
        var bar = $('progress-bar');
        if (!bar) return;
        var pct = Math.min(95, (elapsedMs / TARGET_DURATION_MS) * 95);
        bar.style.width = pct + '%';
        if (elapsedMs >= SLOW_WARN_MS) {
          var note = $('progress-note');
          if (note && !note.dataset.slowFlagged) {
            note.dataset.slowFlagged = '1';
            note.textContent =
              '通常より時間がかかっています。しばらく待ってもこのまま進まない場合は、ページを再読み込みしてください。';
          }
        }
      }

      function showFailed(message) {
        var inProgress = $('state-in-progress');
        if (inProgress) inProgress.style.display = 'none';
        var failed = $('state-failed');
        if (failed) {
          failed.style.display = '';
          var msgEl = $('failed-message');
          if (msgEl && message) msgEl.textContent = message;
          // Wire up the dismiss button now (might not have existed at SSR).
          var btn = $('dismiss-failed-button');
          if (btn) btn.onclick = dismissFailed;
        } else {
          // SSR didn't render the failed card — refresh to pick it up.
          window.location.reload();
        }
      }

      function reloadWithSuccess() {
        // Clear any banner query params before reload so the next view
        // doesn't show the install banner indefinitely.
        var url = new URL(window.location.href);
        url.searchParams.delete('install_ok');
        url.searchParams.delete('install_error');
        url.searchParams.set('updated', '1');
        window.location.href = url.toString();
      }

      function dismissFailed() {
        fetch('/api/admin/update/release', { method: 'POST' })
          .catch(function () {})
          .then(function () {
            window.location.href = '/admin/update';
          });
      }

      var activeConfirmRespond = null;

      function closeInlineConfirm(confirmed) {
        var overlay = $('update-confirm-overlay');
        if (overlay) overlay.hidden = true;
        document.body.classList.remove('confirm-open');
        var respond = activeConfirmRespond;
        activeConfirmRespond = null;
        if (respond) respond(confirmed);
      }

      function showInlineConfirm(options, respond) {
        if (activeConfirmRespond) activeConfirmRespond(false);
        activeConfirmRespond = respond;

        var overlay = $('update-confirm-overlay');
        var dialog = $('update-confirm-dialog');
        var title = $('update-confirm-title');
        var message = $('update-confirm-message');
        var cancel = $('update-confirm-cancel');
        var submit = $('update-confirm-submit');
        if (!overlay || !dialog || !title || !message || !cancel || !submit) {
          activeConfirmRespond = null;
          respond(false);
          return;
        }

        dialog.dataset.tone = options.tone || 'default';
        title.textContent = options.title || '確認';
        message.textContent = options.message || '';
        message.hidden = !options.message;
        cancel.textContent = options.cancelLabel || 'キャンセル';
        submit.textContent = options.confirmLabel || '実行する';
        overlay.hidden = false;
        document.body.classList.add('confirm-open');
        cancel.focus();
      }

      function adminConfirm(options) {
        return new Promise(function (resolve) {
          var settled = false;
          function respond(confirmed) {
            if (settled) return;
            settled = true;
            resolve(confirmed);
          }
          var event = new CustomEvent('ilpb-admin-confirm', {
            cancelable: true,
            detail: {
              options: options,
              respond: respond,
            },
          });
          var handled = !window.dispatchEvent(event);
          if (handled) return;
          showInlineConfirm(options, respond);
        });
      }

      var confirmOverlay = $('update-confirm-overlay');
      var confirmCancel = $('update-confirm-cancel');
      var confirmSubmit = $('update-confirm-submit');
      if (confirmOverlay) {
        confirmOverlay.addEventListener('click', function (event) {
          if (event.target === confirmOverlay) closeInlineConfirm(false);
        });
      }
      if (confirmCancel) {
        confirmCancel.addEventListener('click', function () {
          closeInlineConfirm(false);
        });
      }
      if (confirmSubmit) {
        confirmSubmit.addEventListener('click', function () {
          closeInlineConfirm(true);
        });
      }
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && activeConfirmRespond) {
          closeInlineConfirm(false);
        }
      });

      // ---- onClick: kick off update --------------------------------
      var runBtn = $('run-update-button');
      if (runBtn) {
        runBtn.addEventListener('click', function () {
          // Last-chance confirmation. Once the run starts the flow
          // commits a new commit on the customer's repository and triggers a
          // Cloudflare rebuild, neither of which has a cancel button.
          // The DB / GitHub auto-rollback paths catch *failures*, but
          // there's no "undo a successful update" — so we make the
          // operator opt in explicitly.
          adminConfirm({
            title: 'アップデートを開始しますか?',
            message:
              '開始すると途中で止めることはできません。\n' +
              '失敗した場合は自動で元に戻しますが、成功した場合は元に戻せません。',
            confirmLabel: '開始する',
            tone: 'warning',
          }).then(function (ok) {
            if (!ok) return;
            runBtn.disabled = true;
            runBtn.textContent = '開始しています…';
            fetch('/api/admin/update/run', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
            })
            .then((res) =>
              res.json().then((json) => ({ status: res.status, json: json }))
            )
            .then(function (resp) {
              var data = resp.json && resp.json.data;
              var err = resp.json && resp.json.error;

              if (resp.status === 400 && err && err.details && err.details.code === 'install_required') {
                // First-time path: bounce to install round-trip.
                window.location.href = err.details.install_url || '/admin/update/oauth/start';
                return;
              }

              if (resp.status === 200 && data && data.stage === 'noop') {
                // Already up to date — nothing to deploy.
                reloadWithSuccess();
                return;
              }

              if (resp.status === 202 && data && data.stage === 'building') {
                // Sync landed, build is rolling. Re-render via reload
                // so the SSR snapshot reflects the new lock state.
                window.location.reload();
                return;
              }

              if (resp.status === 409 && err && err.details) {
                if (err.details.code === 'in_progress') {
                  window.location.reload();
                  return;
                }
                if (err.details.code === 'merge_conflict') {
                  showFailed(
                    'GitHubの同期で衝突が発生しました。リポジトリをupstreamに手動で合わせてから再試行してください。'
                  );
                  return;
                }
              }

              showFailed(
                'アップデートの開始に失敗しました（' +
                  resp.status +
                  ')。少し待ってからもう一度お試しください。'
              );
            })
            .catch(function (e) {
              console.error('update run failed:', e);
              showFailed('通信エラーが発生しました。ページを再読み込みしてからもう一度お試しください。');
            });
          });
        });
      }

      // ---- failed card dismiss button (rendered at SSR) ------------
      var ssrDismiss = $('dismiss-failed-button');
      if (ssrDismiss) ssrDismiss.onclick = dismissFailed;

      // ---- polling loop (only when SSR rendered an in-progress card)
      if (!bootstrap.lock || bootstrap.lock.stage === 'failed') return;

      var startedAt = bootstrap.lock.startedAt || Date.now();
      var fromVersion = bootstrap.lock.fromVersion || bootstrap.currentVersion;
      applyStage(bootstrap.lock.stage);

      // Set true after the polling loop calls /api/admin/update/revert,
      // so we don't fire it twice if the next status poll still
      // returns 'building' (the revert response races with the lock
      // flip in KV).
      var revertRequested = false;

      function requestRevert(reason) {
        if (revertRequested) return;
        revertRequested = true;
        fetch('/api/admin/update/revert', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason: reason }),
        })
          .then(function (r) {
            return r.json();
          })
          .catch(function () {
            return null;
          })
          .then(function (json) {
            var revert = json && json.success && json.data && json.data.revert;
            var msg;
            if (!revert) {
              msg =
                'ビルドが時間内に完了しませんでした。元の状態に戻そうとしましたが、結果を確認できませんでした。';
            } else if (revert.status === 'reverted') {
              msg =
                'ビルドが時間内に完了しませんでした。GitHubを元のバージョンに戻しました。少し待ってからもう一度お試しください。';
            } else if (revert.status === 'no_install') {
              msg =
                'ビルドが時間内に完了しませんでした。GitHub Appの連携情報がないため、自動巻き戻しができません。手動で前のリリースに戻してください。';
            } else if (revert.status === 'noop') {
              msg =
                'ビルドが時間内に完了しませんでした。巻き戻し対象の差分はありませんでした。Cloudflareのビルド画面を確認してください。';
            } else {
              msg =
                'ビルドが時間内に完了しませんでした。自動的な巻き戻しに失敗しました。GitHubとCloudflareの状態を確認してください。';
            }
            showFailed(msg);
          });
      }

      function tick() {
        var elapsed = Date.now() - startedAt;
        updateProgressBar(elapsed);

        if (elapsed > TIMEOUT_MS) {
          showFailed(
            'タイムアウトしました（10分以上応答なし）。CloudflareのBuilds画面を確認してください。'
          );
          return;
        }

        Promise.all([
          fetch('/api/admin/update/status').then(function (r) {
            return r.json();
          }),
          fetch('/api/version', { cache: 'no-store' }).then(function (r) {
            return r.json();
          }),
        ])
          .then(function (results) {
            var statusJson = results[0];
            var versionJson = results[1];

            // Detect rollover: this Worker's /api/version flips when
            // Cloudflare swaps in the new isolate.
            if (
              versionJson &&
              versionJson.success &&
              versionJson.data &&
              versionJson.data.version &&
              versionJson.data.version !== fromVersion
            ) {
              // Release the lock so the operator can navigate, then
              // reload to render the post-update UI.
              fetch('/api/admin/update/release', { method: 'POST' })
                .catch(function () {})
                .then(reloadWithSuccess);
              return;
            }

            if (statusJson && statusJson.success && statusJson.data) {
              var s = statusJson.data;
              if (s.status === 'failed') {
                showFailed(s.error_message);
                return;
              }
              if (s.status === 'idle') {
                // Lock disappeared without a version change — most
                // likely a TTL timeout. Treat as failure.
                showFailed(
                  'アップデートが完了せずに終了しました。再度お試しください。'
                );
                return;
              }
              if (s.status === 'in_progress' && s.stage) {
                applyStage(s.stage);
                // Build-stuck detection. If we've been on 'building'
                // (or its successor 'verifying' — which is set by
                // server-side advance, not a real signal that anything
                // booted) for past BUILD_STUCK_MS, kick off a revert
                // before the long TIMEOUT_MS hits. Don't fire from the
                // 'syncing' stage: the syncFromUpstream path has its
                // own server-side error handling that calls markFailed
                // directly, no client revert needed.
                if (
                  !revertRequested &&
                  (s.stage === 'building' || s.stage === 'verifying') &&
                  elapsed > BUILD_STUCK_MS
                ) {
                  requestRevert('build_timeout');
                  return;
                }
              }
            }

            setTimeout(tick, POLL_INTERVAL_MS);
          })
          .catch(function (e) {
            console.error('status poll failed:', e);
            // Transient — retry on the next tick.
            setTimeout(tick, POLL_INTERVAL_MS);
          });
      }

      tick();
    })();
  </script>
</body>
</html>

<style>
  /* Standalone styles — no Tailwind / no global.css. The whole point
     of this page is that it renders even when other CSS layers fail
     to load. */
  :global(body) {
    margin: 0;
    background: #f5f7fa;
    color: #1a1a1a;
    font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN',
      'Noto Sans JP', sans-serif;
  }

  .update-page {
    min-height: 100vh;
    max-width: 720px;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 0.75rem;
