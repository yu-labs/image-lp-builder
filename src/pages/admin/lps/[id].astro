---
/**
 * /admin/lps/:id
 *
 * LP edit screen. Server-renders the current state (sections,
 * status, etc.) and hosts an LpActions React island for the
 * publish / unpublish / delete buttons.
 *
 * Section editing UI (image upload, drag-and-drop reordering,
 * CTA placement) is added in subsequent steps.
 */

import AdminLayout from '../../../layouts/AdminLayout.astro';
import LpActions from '../../../components/admin/LpActions';
import SectionAdder from '../../../components/admin/SectionAdder';
import SectionList from '../../../components/admin/SectionList';
import PreviewModal from '../../../components/admin/PreviewModal';
// QrModal moved into the unified preview tab (📱 panel of mock.astro);
// keeping the import would be dead code.
// import QrModal from '../../../components/admin/QrModal';
import LpAppearancePanel from '../../../components/admin/LpAppearancePanel';
import LpPublicUrlControl from '../../../components/admin/LpPublicUrlControl';
import LpTitleControl from '../../../components/admin/LpTitleControl';
import PublishPanel from '../../../components/admin/PublishPanel';
import LpMetaPanel from '../../../components/admin/LpMetaPanel';
import UtmLinksPanel from '../../../components/admin/UtmLinksPanel';
import PromotionsPanel from '../../../components/admin/PromotionsPanel';
import LpHubConnectorPanel from '../../../components/admin/LpHubConnectorPanel';
import DistributionUrlCopy from '../../../components/admin/DistributionUrlCopy';
import { env } from 'cloudflare:workers';
import {
  hasPagePendingChanges,
  pageQueries,
  readLpHubConnectorEnabled,
} from '../../../lib/db';
import { parseContent } from '../../../lib/content';
import { statusInfo } from '../../../lib/labels';

export const prerender = false;

const { id } = Astro.params;
if (typeof id !== 'string' || id.length === 0) {
  return new Response('Not Found', { status: 404 });
}

const db = env?.DB;
const workspaceId = Astro.locals.workspace_id;
const lp = db
  ? await pageQueries.findByIdWithDraft(db, workspaceId, id)
  : null;
if (!lp) {
  return new Response('Not Found', { status: 404 });
}
if (lp.status === 'trash') {
  return Astro.redirect('/admin', 302);
}

const content = parseContent(lp.content);
const statusBadge = statusInfo(lp.status);
const lpHubConnectorEnabled = readLpHubConnectorEnabled(lp.meta);
const displayTitle = lp.title?.trim() || lp.slug;
const hasPendingChanges = hasPagePendingChanges(lp);
const passwordProtected = !!lp.password_hash;
const hasPublishSchedule = !!(lp.publish_at || lp.unpublish_at);
const publishStepCopy =
  lp.status === 'published'
    ? hasPendingChanges
      ? {
          title: 'ここから再公開できます',
          description:
            '編集内容を公開URLへ反映します。',
        }
      : {
          title: '公開中です',
          description:
            '流入経路URLのコピー・公開停止ができます。',
        }
    : {
        title: 'ここまでで公開できます',
        description:
          '公開後は流入経路URLのコピー・公開停止ができます。',
      };
const shortDate = (value: string | null | undefined) => {
  const date = value?.match(/\d{4}-\d{2}-\d{2}/)?.[0];
  return date ? date.replace(/-/g, '.') : '';
};
const updatedDate = shortDate(lp.updated_at);
const createdDate = shortDate(lp.created_at);

---

<AdminLayout title={`Edit: ${displayTitle}`}>
  <div class="editor-page">
    <a href="/admin" class="back-link">← LP一覧に戻る</a>

    <header class="editor-hero">
      <div class="hero-content">
        <div class="hero-main">
          <div class="hero-kicker-row">
            <span class={`status-chip status-chip-${lp.status}`}>
              {statusBadge.label}
            </span>
            <button
              type="button"
              class="password-chip"
              data-password-chip
              hidden={!passwordProtected}
            >
              パスワード保護中
            </button>
            <button
              type="button"
              class="schedule-chip"
              data-schedule-chip
              hidden={!hasPublishSchedule}
            >
              公開期間あり
            </button>
            <p class="hero-date-meta">
              {updatedDate && <span>更新 {updatedDate}</span>}
              {updatedDate && createdDate && <span aria-hidden="true">｜</span>}
              {createdDate && <span>作成 {createdDate}</span>}
            </p>
          </div>
          <LpTitleControl
            lpId={lp.id}
            title={displayTitle}
            client:load
          />
          <div class="hero-url-row">
            <div class="hero-url-control">
              <LpPublicUrlControl
                lpId={lp.id}
                slug={lp.slug}
                isPublished={lp.status === 'published'}
                client:load
              />
            </div>
            <div class="hero-actions">
              <PreviewModal lpId={lp.id} client:load />
              <LpActions
                lp={{ id: lp.id, slug: lp.slug, status: lp.status }}
                initialHasPendingChanges={hasPendingChanges}
                client:load
              />
            </div>
          </div>
        </div>
      </div>
    </header>

    <div class="step-stack">
      <section id="panel-sections" class="guided-step is-active">
        <div class="step-header">
          <div class="step-title-block">
            <span class="step-number">1</span>
            <div>
              <h2>LP画像とボタンを作る</h2>
              <p>
                LP画像とリンクボタンを設定します。
              </p>
            </div>
          </div>
          <div class="step-action">
            <SectionAdder lpId={lp.id} client:load />
          </div>
        </div>

        <div class="step-body">
          <SectionList
            lpId={lp.id}
            initialSections={content.sections}
            initialArchivedSections={content.archived_sections ?? []}
            client:only="react"
          />

        </div>
      </section>

      <section class="guided-step preview-step">
        <div class="step-header">
          <div class="step-title-block">
            <span class="step-number">2</span>
            <div>
              <h2>スマホで確認する</h2>
              <p>
                LPの見え方を確認します。
              </p>
            </div>
          </div>
          <div class="step-action">
            <PreviewModal lpId={lp.id} client:load />
          </div>
        </div>
      </section>

      <section class="guided-step">
        <div class="step-header">
          <div class="step-title-block">
            <span class="step-number">3</span>
            <div>
              <h2>見た目を整える</h2>
              <p>
                表示幅・背景・装飾を調整します。
              </p>
            </div>
          </div>
        </div>

        <div class="step-body publish-shell appearance-stack">
          <LpAppearancePanel
            lpId={lp.id}
            initialMaxWidth={lp.max_width}
            initialBackgroundColor={lp.background_color}
            initialFrameStyle={lp.frame_style}
            client:load
          />
          <div class="conversion-panel-divider">
            <PromotionsPanel
              lpId={lp.id}
              initialPromotions={content.promotions ?? {}}
              client:load
            />
          </div>
        </div>
      </section>

      <section id="panel-publish" class="guided-step publish-final-step">
        <div class="step-header">
          <div class="step-title-block">
            <span class="step-number">4</span>
            <div>
              <h2>{publishStepCopy.title}</h2>
              <p>{publishStepCopy.description}</p>
            </div>
          </div>
          <div class="step-action final-publish-action">
            <LpActions
              lp={{ id: lp.id, slug: lp.slug, status: lp.status }}
              showMenu={false}
              initialHasPendingChanges={hasPendingChanges}
              client:load
            />
          </div>
        </div>
        <div class="step-body distribution-shell">
          <DistributionUrlCopy
            lpId={lp.id}
            slug={lp.slug}
            isPublished={lp.status === 'published'}
            client:load
          />
        </div>
      </section>

      <section id="panel-publish-options" class="guided-step optional-step">
        <details data-publish-details open={!!(passwordProtected || hasPublishSchedule)}>
          <summary>
            <span class="step-number">5</span>
            <span class="summary-copy">
              <span>公開オプション</span>
              <small>
                パスワード・予約公開・公開停止日時を設定できます。
              </small>
            </span>
            <span class="summary-state" aria-hidden="true"></span>
          </summary>

          <div class="step-body publish-shell">
            <PublishPanel
              lpId={lp.id}
              initialPublishAt={lp.publish_at}
              initialUnpublishAt={lp.unpublish_at}
              initialPasswordProtected={passwordProtected}
              client:load
            />
          </div>
        </details>
      </section>

      <section class="guided-step optional-step">
        <details data-advanced-details>
          <summary>
            <span class="step-number">6</span>
            <span class="summary-copy">
              <span>詳細設定</span>
              <small>SEO・SNSシェア・流入経路URL・外部連携を設定できます。</small>
            </span>
            <span class="summary-state" aria-hidden="true"></span>
          </summary>

          <div class="advanced-stack">
            <div id="panel-meta" class="settings-panel">
              <LpMetaPanel
                lpId={lp.id}
                initialMeta={content.meta ?? {}}
                sections={content.sections}
                client:load
              />
            </div>

            <div id="panel-utm" class="settings-panel">
              <UtmLinksPanel lpId={lp.id} slug={lp.slug} client:load />
            </div>

            <div class="settings-panel">
              <LpHubConnectorPanel
                lpId={lp.id}
                initialEnabled={lpHubConnectorEnabled}
                client:load
              />
            </div>

            <div class="publish-return-row">
              <a
                href="#panel-publish"
                class="publish-return-link"
                data-publish-return
              >
                公開ボタンに進む
              </a>
            </div>
          </div>
        </details>
      </section>
    </div>
  </div>
</AdminLayout>

<script>
  import {
    LP_PASSWORD_STATE_CHANGED,
    LP_SCHEDULE_STATE_CHANGED,
  } from '../../../lib/lp-events';

  const passwordChip =
    document.querySelector<HTMLButtonElement>('[data-password-chip]');
  const scheduleChip =
    document.querySelector<HTMLButtonElement>('[data-schedule-chip]');
  const publishDetails =
    document.querySelector<HTMLDetailsElement>('[data-publish-details]');
  const advancedDetails =
    document.querySelector<HTMLDetailsElement>('[data-advanced-details]');
  const publishOptionsPanel = document.getElementById('panel-publish-options');
  const publishPanel = document.getElementById('panel-publish');
  const publishReturnLink =
    document.querySelector<HTMLAnchorElement>('[data-publish-return]');

  function scrollToPanel(el: HTMLElement | null) {
    if (!el) return;
    const top = Math.max(0, el.getBoundingClientRect().top + window.scrollY - 96);
    window.scrollTo({ top, behavior: 'smooth' });
  }

  function scrollToPublishSettings() {
    if (publishDetails) {
      publishDetails.open = true;
    }
    scrollToPanel(publishOptionsPanel);
  }

  window.addEventListener(LP_PASSWORD_STATE_CHANGED, (event) => {
    const protectedState = Boolean(
      (event as CustomEvent<{ protected?: boolean }>).detail?.protected
    );
    if (passwordChip) {
      passwordChip.hidden = !protectedState;
    }
  });

  window.addEventListener(LP_SCHEDULE_STATE_CHANGED, (event) => {
    const hasSchedule = Boolean(
      (event as CustomEvent<{ hasSchedule?: boolean }>).detail?.hasSchedule
    );
    if (scheduleChip) {
      scheduleChip.hidden = !hasSchedule;
    }
  });

  passwordChip?.addEventListener('click', scrollToPublishSettings);
  scheduleChip?.addEventListener('click', scrollToPublishSettings);

  publishReturnLink?.addEventListener('click', (event) => {
    event.preventDefault();
    scrollToPanel(publishPanel);
  });

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const link = target?.closest<HTMLAnchorElement>('[data-open-advanced]');
    if (!link) return;
    const panel = document.querySelector<HTMLElement>(link.hash);
    if (!panel) return;
    event.preventDefault();
    if (advancedDetails) {
      advancedDetails.open = true;
    }
    window.dispatchEvent(new CustomEvent('ilpb:open-utm-panel'));
    scrollToPanel(panel);
    history.replaceState(null, '', `${location.pathname}${location.search}`);
  });
</script>

<style>
  .editor-page {
    --editor-primary: #567baf;
    --editor-primary-soft: #eef4fb;
    --editor-ink: #3f4352;
    --editor-muted: #8b91a1;
    max-width: 980px;
    margin: 0 auto;
  }

  .back-link {
    color: var(--editor-muted);
    display: inline-flex;
    font-size: 0.9rem;
    font-weight: 700;
    margin-bottom: 1.1rem;
    transition: color 0.15s ease;
  }

  .back-link:hover {
    color: var(--editor-primary);
  }

  .editor-hero {
    background: rgba(255, 255, 255, 0.76);
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.25rem;
    box-shadow: 0 18px 44px rgba(31, 34, 48, 0.07);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 1.35rem;
    padding: 1.25rem;
    position: relative;
  }

  .hero-content {
    align-items: flex-end;
    display: flex;
    gap: 1.5rem;
    justify-content: space-between;
    padding-right: 0;
    width: 100%;
  }

  .hero-main {
    flex: 1;
    min-width: 0;
  }

  .hero-kicker-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-bottom: 0.35rem;
    padding-right: 3.75rem;
  }

  .hero-main :global(h1) {
    color: var(--editor-ink);
    font-size: 1.95rem;
    font-weight: 800;
    line-height: 1.18;
    margin: 0;
    overflow-wrap: anywhere;
    padding-right: 3.75rem;
  }

  .hero-main :global(.lp-title-control h1) {
    padding-right: 0;
  }

  .hero-url-row {
    align-items: flex-end;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    width: 100%;
  }

  .hero-url-control {
    min-width: 0;
  }

  .hero-date-meta {
    align-items: center;
    color: rgba(107, 116, 134, 0.82);
    display: flex;
    flex-wrap: wrap;
    font-size: 0.68rem;
    font-weight: 400;
    gap: 0.18rem;
    line-height: 1.5;
    margin: 0;
  }

  .status-chip,
  .password-chip,
  .schedule-chip {
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 800;
    margin-right: 0.65rem;
    padding: 0.28rem 0.65rem;
  }

  .status-chip-draft {
    background: #fff6db;
    color: #9a6f2e;
  }

  .status-chip-published {
    background: #e9f8ef;
    color: #3f7a52;
  }

  .status-chip-preview,
  .status-chip-archived {
    background: #eef3fb;
    color: var(--editor-primary);
  }

  .status-chip-trash {
    background: #fff1f1;
    color: #b83232;
  }

  .password-chip,
  .schedule-chip {
    background: transparent;
    border: 0;
    color: var(--editor-primary);
    cursor: pointer;
    font-family: inherit;
    padding-left: 0;
    padding-right: 0;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .password-chip:hover,
  .schedule-chip:hover {
    color: #476895;
  }

  .hero-actions {
    align-items: center;
    align-self: flex-end;
    display: flex;
    flex: 0 0 auto;
    gap: 0.7rem;
    justify-content: flex-end;
    margin-bottom: 0.02rem;
    min-width: max-content;
  }

  .step-stack {
    display: grid;
    gap: 1.25rem;
  }

  .guided-step {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.72);
    border-radius: 1.25rem;
    box-shadow: 0 16px 38px rgba(31, 34, 48, 0.065);
    overflow: hidden;
  }

  .guided-step.is-active {
    box-shadow: 0 18px 48px rgba(31, 34, 48, 0.085);
  }

  .step-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    padding: 1.25rem 1.35rem;
  }

  .preview-step .step-header {
    align-items: center;
  }

  .step-title-block {
    align-items: center;
    display: flex;
    gap: 0.85rem;
    min-width: 0;
  }

  .step-number {
    align-items: center;
    background: var(--editor-primary-soft);
    border-radius: 0.9rem;
    color: var(--editor-primary);
    display: inline-flex;
    flex: 0 0 auto;
    font-size: 0.95rem;
    font-weight: 900;
    height: 2.45rem;
    justify-content: center;
    width: 2.45rem;
  }

  .step-header h2 {
    color: var(--editor-ink);
    font-size: 1.08rem;
    font-weight: 800;
    line-height: 1.3;
    margin: 0;
  }

  .step-header p {
    color: var(--editor-muted);
    font-size: 0.88rem;
    font-weight: 400;
    line-height: 1.55;
    margin: 0.25rem 0 0;
  }

  .step-action {
    align-items: center;
    display: flex;
    flex: 0 0 auto;
    gap: 0.65rem;
    justify-content: flex-end;
  }

  .step-body {
    border-top: 1px solid rgba(226, 231, 240, 0.86);
    padding: 1.25rem 1.35rem 1.45rem;
  }

  .appearance-stack {
    display: grid;
    gap: 1.25rem;
  }

  .conversion-panel-divider {
    border-top: 1px solid rgba(226, 231, 240, 0.86);
    padding-top: 1.25rem;
  }

  .hero-actions :global(a[data-preview-open]),
  .step-action :global(a[data-preview-open]),
  .step-action :global(.section-add-button) {
    align-items: center;
    background: var(--editor-primary) !important;
    border: 0 !important;
    border-radius: 999px !important;
    box-shadow: 0 12px 24px rgba(86, 123, 175, 0.18) !important;
    color: #ffffff !important;
    display: inline-flex;
    font-weight: 800 !important;
    justify-content: center;
    cursor: pointer;
    text-decoration: none !important;
    transition: background 0.16s ease, box-shadow 0.16s ease, color 0.16s ease;
  }

  .hero-actions :global(a[data-preview-open]:hover),
  .step-action :global(a[data-preview-open]:hover),
  .step-action :global(.section-add-button:hover) {
    background: #4c6f9f !important;
    box-shadow: 0 14px 28px rgba(86, 123, 175, 0.22) !important;
  }

  .step-action :global([data-lp-actions-menu] > button) {
    background: transparent !important;
    box-shadow: none !important;
    color: var(--editor-muted) !important;
    padding: 0.55rem !important;
  }

  .hero-actions :global(.lp-actions-root) {
    align-items: center;
    display: flex;
    gap: 0.55rem;
  }

  .hero-actions :global(a[data-preview-open]),
  .step-action :global(a[data-preview-open]) {
    background: rgba(255, 255, 255, 0.92) !important;
    border: 1px solid rgba(86, 123, 175, 0.32) !important;
    box-shadow: 0 14px 28px rgba(86, 123, 175, 0.14) !important;
    color: var(--editor-primary) !important;
    min-height: 3rem;
    padding: 0.72rem 1.2rem 0.72rem 0.85rem !important;
  }

  .hero-actions :global(a[data-preview-open]:hover),
  .step-action :global(a[data-preview-open]:hover) {
    background: #eef4fb !important;
    box-shadow: 0 16px 30px rgba(86, 123, 175, 0.2) !important;
  }

  .hero-actions :global(a[data-preview-open] .preview-open-icon),
  .step-action :global(a[data-preview-open] .preview-open-icon) {
    align-items: center;
    background: var(--editor-primary-soft);
    border-radius: 999px;
    display: inline-flex;
    height: 2rem;
    justify-content: center;
    width: 2rem;
  }

  .hero-actions :global(.lp-action-menu-button) {
    align-items: center;
    background: rgba(242, 244, 248, 0.92) !important;
    border-radius: 999px !important;
    box-shadow: none !important;
    color: var(--editor-muted) !important;
    display: inline-flex;
    height: 3rem;
    justify-content: center;
    width: 3rem;
  }

  .hero-actions :global(.lp-action-menu-button span) {
    font-size: 1.55rem !important;
    line-height: 1 !important;
  }

  .hero-actions :global(.lp-action-menu-button:hover) {
    background: var(--editor-primary-soft) !important;
    color: var(--editor-primary) !important;
  }

  .hero-actions :global(.lp-action-menu) {
    border: 0 !important;
    border-radius: 1rem !important;
    box-shadow: 0 18px 38px rgba(31, 34, 48, 0.12) !important;
    overflow: hidden;
    padding: 0.35rem !important;
    z-index: 40 !important;
  }

  .hero-actions :global([data-lp-actions-menu]) {
    position: absolute !important;
    right: 1rem;
    top: 0.95rem;
    z-index: 35;
  }

  .step-action :global([data-lp-actions-menu] > button:hover) {
    background: var(--editor-primary-soft) !important;
    color: var(--editor-primary) !important;
  }

  .step-action :global([role="menu"]) {
    border: 1px solid rgba(226, 231, 240, 0.95) !important;
    border-radius: 1rem !important;
    box-shadow: 0 18px 38px rgba(31, 34, 48, 0.12) !important;
    overflow: hidden;
    padding: 0.35rem !important;
  }

  .step-action :global([role="menuitem"]) {
    border-radius: 0.8rem !important;
  }

  .publish-final-step {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.86), rgba(238, 244, 251, 0.72));
  }

  .final-publish-action :global(.lp-actions-root) {
    display: flex;
    justify-content: flex-end;
    width: auto;
  }

  .publish-shell :global(section) {
    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;
    margin-bottom: 0 !important;
    padding: 0 !important;
  }

  .publish-shell :global(input),
  .publish-shell :global(select),
  .publish-shell :global(textarea) {
    border-color: #d7deea !important;
    border-radius: 0.75rem !important;
    color: var(--editor-ink) !important;
  }

  .editor-page :global(.color-input) {
    appearance: none;
    -webkit-appearance: none;
    background: #ffffff !important;
    border: 1px solid #d7deea !important;
    border-radius: 0.75rem !important;
    cursor: pointer;
    overflow: hidden;
    padding: 3px !important;
  }

  .editor-page :global(.color-input::-webkit-color-swatch-wrapper) {
    padding: 0;
  }

  .editor-page :global(.color-input::-webkit-color-swatch) {
    border: 0;
    border-radius: 0.55rem;
  }

  .editor-page :global(.color-input::-moz-color-swatch) {
    border: 0;
    border-radius: 0.55rem;
  }

  .publish-shell :global(input[type="radio"]),
  .publish-shell :global(input[type="checkbox"]) {
    accent-color: var(--editor-primary);
    cursor: pointer;
    height: 1rem;
    width: 1rem;
