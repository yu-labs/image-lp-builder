---
/**
 * /admin/lps/:id/preview/mock
 *
 * Unified preview hub. Opened via window.open() from the editor's
 * "プレビュー" button (so the operator can drag it to a second
 * monitor, off-screen, etc.).
 *
 * Desktop/tablet tabs:
 *   📱 スマホ      — iPhone mock + static QR code so the user can
 *                    scan with a real device even before client JS hydrates.
 *   🖥 デスクトップ — full-width LP at the configured max_width.
 *
 * Real phone browsers are redirected straight to the LP preview
 * route. Showing a phone mock inside a phone makes the confirmation
 * screen smaller and causes a flash of the desktop preview shell.
 *
 * The same iframe element is reused; switching tabs just changes
 * the wrapper layout. Topbar carries an "編集に戻る" button that
 * closes the window when opened via window.open() or otherwise
 * navigates back to the editor.
 */

import { env } from 'cloudflare:workers';
import '../../../../../styles/global.css';
import { generateId, pageQueries, siteMetaQueries } from '../../../../../lib/db';
import { createQrSvg } from '../../../../../lib/qr-svg.js';

export const prerender = false;

const { id } = Astro.params;
if (typeof id !== 'string' || id.length === 0) {
  return new Response('Not Found', { status: 404 });
}

const db = env?.DB;
const workspaceId = Astro.locals.workspace_id;
const lp = db ? await pageQueries.findById(db, workspaceId, id) : null;
if (!lp) {
  return new Response('Not Found', { status: 404 });
}

const previewUrl = `/admin/lps/${id}/preview`;
const editorUrl = `/admin/lps/${id}`;
const userAgent = Astro.request.headers.get('user-agent') ?? '';
const isPhoneBrowser =
  /iPhone|iPod|Android.*Mobile|Windows Phone|IEMobile|BlackBerry/i.test(userAgent);
if (isPhoneBrowser) {
  return Astro.redirect(previewUrl, 302);
}
const isPublished = lp.status === 'published';
const siteMeta = db ? await siteMetaQueries.get(db, workspaceId) : null;
const initialPublicOrigin = siteMeta?.domain?.trim()
  ? `https://${siteMeta.domain.trim()}`
  : Astro.url.origin;
let initialPreviewToken = lp.preview_token;
if (!isPublished && db && !initialPreviewToken) {
  const updated = await pageQueries.setPreviewToken(
    db,
    workspaceId,
    lp.id,
    generateId()
  );
  initialPreviewToken = updated?.preview_token ?? null;
}
const initialQrUrl = isPublished
  ? `${initialPublicOrigin}/${lp.slug}`
  : initialPreviewToken
    ? `${initialPublicOrigin}/preview/${initialPreviewToken}`
    : '';
const qrSvg = initialQrUrl
  ? createQrSvg(initialQrUrl, {
      size: 220,
      level: 'M',
      marginSize: 4,
      bgColor: '#ffffff',
      fgColor: '#111827',
    })
  : '';
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>プレビュー: {lp.slug}</title>
  <style>
    :root { color-scheme: light; }
    * { box-sizing: border-box; }
    /* html / body share the dark backdrop so the area outside `body`
       (when the viewport is taller than content) doesn't flash white. */
    html, body {
      background: #1f1f23;
      height: 100%;
    }
    body {
      margin: 0;
      min-height: 100vh;
      height: 100vh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN', 'Noto Sans JP', sans-serif;
      color: #e5e7eb;
    }

    /* Topbar */
    .topbar {
      position: sticky;
      top: 0;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px 12px;
      background: rgba(20, 20, 24, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      z-index: 10;
      flex-wrap: wrap;
    }
    .back-btn {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      color: #e5e7eb;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 500;
      cursor: pointer;
      text-decoration: none;
    }
    .back-btn:hover { background: rgba(255, 255, 255, 0.12); }
    .label {
      font-size: 12px;
      color: #cbd5e1;
    }
    .label strong { color: #ffffff; font-weight: 600; }

    .tabs {
      display: inline-flex;
      gap: 2px;
      background: rgba(255, 255, 255, 0.06);
      padding: 2px;
      border-radius: 8px;
      margin-left: auto;
    }
    .tab {
      border: 0;
      background: transparent;
      color: #cbd5e1;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 500;
      border-radius: 6px;
      cursor: pointer;
    }
    .tab[aria-selected='true'] {
      background: #ffffff;
      color: #111827;
    }
    .reload-btn {
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06);
      color: #e5e7eb;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
    }
    .reload-btn:hover { background: rgba(255, 255, 255, 0.12); }

    /* Stage takes the remaining vertical space so its content can
       center within it (otherwise the phone hugs the topbar with
       big empty space below it). */
    .stage {
      padding: 12px 16px;
      flex: 1;
      display: flex;
      min-height: 0;
      overflow: hidden;
    }

    /* Mobile (phone) tab — phone mock + QR side-by-side, centered
       in the stage's free vertical area. */
    .stage-mobile {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 32px;
      flex-wrap: wrap;
      min-height: 0;
      overflow: auto;
      padding: 8px 0;
    }

    .preview-side {
      display: flex;
      width: 17rem;
      flex-direction: column;
      gap: 12px;
    }

    .preview-note {
      margin: 0;
      border: 1px solid rgba(255, 255, 255, 0.68);
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.9);
      box-shadow: 0 18px 42px rgba(0, 0, 0, 0.18);
      color: #596173;
      font-size: 12px;
      font-weight: 700;
      line-height: 1.65;
      padding: 12px 14px;
    }

    .preview-note strong {
      color: #567baf;
      display: block;
      font-size: 13px;
      margin-bottom: 2px;
    }

    .qr-card {
      display: flex;
      width: 17rem;
      flex-direction: column;
      gap: 1rem;
      border: 1px solid rgba(255, 255, 255, 0.8);
      border-radius: 1.35rem;
      background: rgba(255, 255, 255, 0.9);
      padding: 1rem;
      color: #3f4352;
      box-shadow: 0 22px 54px rgba(31, 34, 48, 0.18);
      backdrop-filter: blur(24px);
    }

    .qr-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .qr-title {
      margin: 0;
      font-size: 0.875rem;
      font-weight: 800;
      line-height: 1.35;
    }

    .qr-subtitle {
      margin: 0.25rem 0 0;
      color: #8b91a1;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.55;
    }

    .qr-badge {
      flex: 0 0 auto;
      border-radius: 999px;
      background: #eef4fb;
      color: #567baf;
      font-size: 10px;
      font-weight: 800;
      line-height: 1.2;
      padding: 0.25rem 0.625rem;
    }

    .qr-box {
      align-self: center;
      border: 1px solid #e2e7f0;
      border-radius: 1.1rem;
      background: #ffffff;
      padding: 0.5rem;
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    }

    :global(.qr-box svg) {
      display: block;
      height: 220px;
      width: 220px;
    }

    .qr-url-input {
      width: 100%;
      cursor: text;
      border: 1px solid #d7deea;
      border-radius: 0.75rem;
      background: #f8fafc;
      color: #596173;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', monospace;
      font-size: 10px;
      font-weight: 600;
      outline: none;
      padding: 0.5rem 0.75rem;
    }

    .qr-copy-button {
      width: 100%;
      min-height: 2.75rem;
      margin-top: 0.5rem;
      cursor: pointer;
      border: 0;
      border-radius: 999px;
      background: #567baf;
      color: #ffffff;
      font-size: 0.875rem;
      font-weight: 800;
      padding: 0.5rem 1rem;
      box-shadow: 0 14px 26px rgba(86, 123, 175, 0.2);
      transition: background 0.16s ease, color 0.16s ease;
    }

    .qr-copy-button:hover {
      background: #4d6f9c;
    }

    .qr-copy-button.is-copied {
      background: #e8f7ef;
      color: #0f8f5c;
    }

    .qr-footnote,
    .qr-local-note {
      margin: 0;
      text-align: center;
      color: #8b91a1;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.55;
    }

    .qr-local-note {
      border: 1px solid #fde68a;
      border-radius: 0.75rem;
      background: #fffbeb;
      color: #92400e;
      padding: 0.5rem 0.75rem;
      text-align: left;
    }

    .qr-empty {
      margin: 0;
      border-radius: 0.75rem;
      background: #fff1f1;
      color: #b83232;
      font-size: 11px;
      font-weight: 800;
      line-height: 1.6;
      padding: 0.75rem;
    }

    /* Desktop tab — single wide iframe centered. */
    .stage-desktop {
      flex: 1;
      display: flex;
      justify-content: center;
      align-items: stretch;
      min-height: 0;
    }

    /* Phone mock */
    .phone-frame {
      position: relative;
      width: 304px;
      padding: 12px;
      border-radius: 44px;
      background: linear-gradient(155deg, #2a2a2c 0%, #1a1a1c 60%, #0a0a0c 100%);
      box-shadow:
        0 20px 50px rgba(0, 0, 0, 0.5),
        inset 0 0 0 1.5px rgba(255, 255, 255, 0.08);
    }
    .phone-screen {
      --phone-screen-width: 280px;
      --phone-viewport-width: 393px;
      --phone-viewport-height: 852px;
      --phone-preview-scale: 0.712468;
      position: relative;
      overflow: hidden;
      background: #ffffff;
      width: var(--phone-screen-width);
      aspect-ratio: 393 / 852;
      border-radius: 32px;
    }
    .phone-island {
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 23px;
      background: #000;
      border-radius: 14px;
      z-index: 5;
      pointer-events: none;
    }
    .phone-screen iframe {
      display: block;
      width: var(--phone-viewport-width);
      height: var(--phone-viewport-height);
      border: 0;
      background: #ffffff;
      transform: scale(var(--phone-preview-scale));
      transform-origin: top left;
    }

    /* Side buttons (decorative) */
    .btn-left-1, .btn-left-2, .btn-right {
      position: absolute;
      width: 2px;
      background: #555;
    }
    .btn-left-1 { left: -2px; top: 80px; height: 24px; border-radius: 2px 0 0 2px; }
    .btn-left-2 { left: -2px; top: 115px; height: 42px; border-radius: 2px 0 0 2px; }
    .btn-right  { right: -2px; top: 100px; height: 64px; border-radius: 0 2px 2px 0; }

    /* Desktop iframe wrapper */
    .desktop-wrap {
      width: 100%;
      max-width: 1100px;
      height: 100%;
      min-height: 0;
      display: flex;
      background: #ffffff;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.4);
    }
    .desktop-wrap iframe {
      display: block;
      width: 100%;
      height: 100%;
      min-height: 0;
      flex: 1;
      border: 0;
      background: #ffffff;
    }

    /* Hidden helper. We use [hidden] at the panel level so the iframe
       doesn't reload between tab switches — moving it via JS would
       trigger a reload and lose scroll position. */
    [hidden] { display: none !important; }

    /* On an actual phone, the preview should be the phone screen
       itself. Showing a phone mock inside a phone makes the viewport
       smaller and hides the real LP scale. */
    @media (max-width: 768px) {
      html,
      body {
        background: #ffffff;
        height: 100%;
        min-height: 100%;
      }

      body {
        overflow: hidden;
      }

      .topbar,
      .preview-side,
      .phone-island,
      .btn-left-1,
      .btn-left-2,
      .btn-right,
      #panel-desktop {
        display: none !important;
      }

      .stage,
      .stage-mobile,
      .phone-frame,
      .phone-screen {
        display: block;
        width: 100%;
        height: 100%;
        min-height: 0;
        margin: 0;
        padding: 0;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        background: #ffffff;
        box-shadow: none;
      }

      .phone-screen {
        --phone-viewport-width: 100vw;
        --phone-viewport-height: 100dvh;
        --phone-preview-scale: 1;
        aspect-ratio: auto;
      }

      .phone-screen iframe {
        width: 100vw;
        height: 100vh;
        height: 100dvh;
        transform: none;
      }
    }
  </style>
</head>
<body>
  <div class="topbar">
    <button type="button" id="back-btn" class="back-btn" title="編集画面に戻る">
      ← 編集に戻る
    </button>
    <span class="label">
      プレビュー: <strong>{lp.slug}</strong>
    </span>

    <div class="tabs" role="tablist" aria-label="プレビュー種別">
      <button type="button" class="tab" role="tab" data-tab="mobile" aria-selected="true">
        📱 スマホ
      </button>
      <button type="button" class="tab" role="tab" data-tab="desktop" aria-selected="false">
        🖥 デスクトップ
      </button>
    </div>

    <button type="button" id="reload-btn" class="reload-btn" title="LPを再読み込み">
      ⟳ 再読込
    </button>
  </div>

  <div class="stage">
    {/* Mobile (phone mock) panel — visible by default. */}
    <div id="panel-mobile" class="stage-mobile" role="tabpanel">
      <div class="phone-frame">
        <span class="btn-left-1"></span>
        <span class="btn-left-2"></span>
        <span class="btn-right"></span>
        <div class="phone-screen">
          <div class="phone-island"></div>
          <iframe
            id="mobile-frame"
            src={previewUrl}
            title="LP プレビュー(スマホ)"
            loading="lazy"
          ></iframe>
        </div>
      </div>
      <aside class="preview-side">
        <p class="preview-note">
          <strong>最終確認はスマホ実機で</strong>
          この画面はプレビューです。最終確認では、QRを読み取って表示とボタン動作を確認してください。
        </p>
        <div class="qr-card">
          <div class="qr-card-header">
            <div>
              <p class="qr-title">実機確認QR</p>
              <p class="qr-subtitle">
                {isPublished ? '公開URLを読み取ります' : 'プレビューURLを読み取ります'}
              </p>
            </div>
            <span class="qr-badge">{isPublished ? '公開URL' : 'プレビュー'}</span>
          </div>

          {qrSvg ? (
            <>
              <div class="qr-box" set:html={qrSvg} />
              <div>
                <input
                  class="qr-url-input"
                  type="text"
                  value={initialQrUrl}
                  readonly
                  data-qr-url-input
                />
                <button class="qr-copy-button" type="button" data-copy-qr-url>
                  URLをコピー
                </button>
              </div>
              <p class="qr-footnote">スマホのカメラで読んで実機確認</p>
              {initialQrUrl.includes('://localhost') || initialQrUrl.includes('://127.') ? (
                <p class="qr-local-note">
                  ローカルURLなので、スマホから見えない場合があります。<br />
                  本番では実際のドメインで確認できます。
                </p>
              ) : null}
            </>
          ) : (
            <p class="qr-empty">QRを表示するURLを取得できませんでした。</p>
          )}
        </div>
      </aside>
    </div>

    {/* Desktop (full width) panel — hidden by default. */}
    <div id="panel-desktop" class="stage-desktop" role="tabpanel" hidden>
      <div class="desktop-wrap">
        <iframe
          id="desktop-frame"
          src={previewUrl}
          title="LP プレビュー(デスクトップ)"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ editorUrl }}>
    // Back to editor: close the popup if we were opened via window.open
    // (window.opener is set), otherwise navigate the current tab back.
    document.getElementById('back-btn')?.addEventListener('click', () => {
      if (window.opener && !window.opener.closed) {
        window.close();
      } else {
        window.location.href = editorUrl;
      }
    });

    // Tab switching: toggle [hidden] on the panels and aria-selected
    // on the tab buttons. Don't re-mount the iframes — keeps scroll
    // position and prevents reloading when toggling.
    const tabs = Array.from(document.querySelectorAll('.tab'));
    const panels = {
      mobile: document.getElementById('panel-mobile'),
      desktop: document.getElementById('panel-desktop'),
    };
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const which = tab.getAttribute('data-tab');
        if (!which || !panels[which]) return;
        tabs.forEach((t) => {
          t.setAttribute(
            'aria-selected',
            t.getAttribute('data-tab') === which ? 'true' : 'false'
          );
        });
        Object.entries(panels).forEach(([key, el]) => {
          if (!el) return;
          if (key === which) {
            el.removeAttribute('hidden');
          } else {
            el.setAttribute('hidden', '');
          }
        });
      });
    });

    // Reload reloads whichever frame is currently visible.
    document.getElementById('reload-btn')?.addEventListener('click', () => {
      const visiblePanel = Object.values(panels).find(
        (p) => p && !p.hasAttribute('hidden')
      );
      const frame = visiblePanel?.querySelector('iframe');
      if (frame instanceof HTMLIFrameElement && frame.contentWindow) {
        frame.contentWindow.location.reload();
      }
    });

    const qrInput = document.querySelector('[data-qr-url-input]');
    if (qrInput instanceof HTMLInputElement) qrInput.addEventListener('click', () => {
      qrInput.select();
    });

    document.querySelector('[data-copy-qr-url]')?.addEventListener('click', async (event) => {
      if (!(qrInput instanceof HTMLInputElement)) return;
      if (!qrInput?.value) return;
      const button = event.currentTarget;
      if (!(button instanceof HTMLButtonElement)) return;
      let copied = false;
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(qrInput.value);
          copied = true;
        }
      } catch {
        copied = false;
      }
      if (!copied) {
        qrInput.focus();
        qrInput.select();
        try {
          const legacyCopy = document['exec' + 'Command'];
          copied =
            typeof legacyCopy === 'function'
              ? legacyCopy.call(document, 'copy')
              : false;
        } catch {
          copied = false;
        }
      }
      if (!copied) return;
      button.classList.add('is-copied');
      const original = button.textContent;
      button.textContent = 'コピー済み';
      window.setTimeout(() => {
        button.classList.remove('is-copied');
        button.textContent = original || 'URLをコピー';
      }, 1500);
    });
  </script>
</body>
</html>
