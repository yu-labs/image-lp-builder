---
import '../styles/global.css';
import AdminConfirmDialog from '../components/admin/AdminConfirmDialog';
import AdminToast from '../components/admin/AdminToast';
import { AlertTriangle, FileText, Link2, Settings, Users, X, Zap } from 'lucide-react';
import { env } from 'cloudflare:workers';
import { checkForUpdate, CURRENT_VERSION } from '../lib/version';
import { roleLabel } from '../lib/labels';
import { isValidManagedProviderUrl, resolveManagedProviderConfig } from '../lib/managed-provider-config';

interface Props {
  title?: string;
}

const { title = 'Image LP Builder' } = Astro.props;
const user = Astro.locals.user;

const typedEnv = env as Env;
const mpConfig = await resolveManagedProviderConfig({
  configUrl: typedEnv.MANAGED_PROVIDER_CONFIG_URL,
});
const providerLinkHref = isValidManagedProviderUrl(mpConfig.providerLink.url)
  ? mpConfig.providerLink.url
  : undefined;
const managedAdminCtaHref = isValidManagedProviderUrl(mpConfig.managedAdminCta.url)
  ? mpConfig.managedAdminCta.url
  : undefined;

const update = await checkForUpdate();
const UpdateIcon = update.isCritical ? AlertTriangle : Zap;

const navItems = [
  { href: '/admin', Icon: FileText, label: 'LP一覧' },
  { href: '/admin/my-links', Icon: Link2, label: 'よく使うリンク' },
  { href: '/admin/site-settings', Icon: Settings, label: 'サイト設定' },
  { href: '/admin/members', Icon: Users, label: 'メンバー管理' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => currentPath === href.replace(/\/$/, '');
const isOnLogoHome = isCurrent('/admin');
const userInitial = user?.email?.trim().charAt(0).toUpperCase() || 'U';
---

<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate icon" href="/favicon.ico" sizes="32x32" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
  <title>{title} | Image LP Builder</title>
</head>
<body>
  <div class="admin-layout">
    <AdminConfirmDialog client:load />
    {update.hasUpdate && (
      <div class={`update-banner ${update.isCritical ? 'update-banner-critical' : ''}`}>
        <span class="update-icon" aria-hidden="true">
          <UpdateIcon size={16} strokeWidth={2.4} />
        </span>
        <span class="update-text">
          {update.isCritical && <strong class="update-critical-label">重要なアップデート</strong>}
          新しいバージョン <strong>v{update.latest}</strong> が公開されています
          <span class="update-current">(現在 v{update.current})</span>
        </span>
        <a href="/admin/update" class="update-button">
          アップデートを確認
        </a>
      </div>
    )}
    <header class="admin-header">
      <div class="header-left">
        <button
          type="button"
          class="sidebar-toggle"
          aria-label="メニューを開く"
          aria-controls="admin-sidebar"
          aria-expanded="false"
          data-sidebar-toggle
        >
          <span class="hamburger-lines" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
        <div class="logo">
          {isOnLogoHome ? (
            <span class="logo-link logo-current" aria-current="page">
              <img src="/logo-lockup.svg" alt="Image LP Builder" class="logo-image" />
            </span>
          ) : (
            <a href="/admin" class="logo-link">
              <img src="/logo-lockup.svg" alt="Image LP Builder" class="logo-image" />
            </a>
          )}
          {mpConfig.providerLink.visible && (
            <span class="logo-by">
              by{' '}
              {providerLinkHref ? (
                <a
                  href={providerLinkHref}
                  class="logo-by-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  data-mp-provider-link
                >
                  {mpConfig.providerLink.label}
                </a>
              ) : (
                <span class="logo-by-link logo-by-link-static" aria-disabled="true">
                  {mpConfig.providerLink.label}
                </span>
              )}
            </span>
          )}
        </div>
      </div>
      <div class="header-right">
        {user && (
          <div class="account-menu" data-account-menu>
            <button
              type="button"
              class="account-trigger"
              aria-label="アカウントメニューを開く"
              aria-haspopup="menu"
              aria-expanded="false"
              data-account-trigger
            >
              <span class="account-avatar" aria-hidden="true">{userInitial}</span>
            </button>
            <div class="account-popover" role="menu" hidden data-account-popover>
              <div class="account-summary">
                <div class="account-email">{user.email}</div>
                <span class={`user-role role-${user.role}`}>{roleLabel(user.role)}</span>
              </div>
              <form method="POST" action="/admin/logout" class="logout-form">
                <button type="submit" class="account-menu-item" role="menuitem">
                  ログアウト
                </button>
              </form>
            </div>
          </div>
        )}
      </div>
    </header>

    <div class="admin-body">
      <div class="sidebar-backdrop" data-sidebar-backdrop aria-hidden="true"></div>
      <aside class="admin-sidebar" id="admin-sidebar" data-sidebar>
        <button
          type="button"
          class="sidebar-close"
          aria-label="メニューを閉じる"
          aria-hidden="true"
          disabled
          tabindex="-1"
          data-sidebar-close
        >
          <X size={22} strokeWidth={2.4} aria-hidden="true" />
        </button>
        <nav class="sidebar-nav">
          {navItems.map((item) => {
            const Icon = item.Icon;
            return isCurrent(item.href) ? (
              <span class="nav-item nav-item-current" aria-current="page">
                <Icon className="nav-icon" size={18} strokeWidth={2.2} aria-hidden="true" />
                <span>{item.label}</span>
              </span>
            ) : (
              <a href={item.href} class="nav-item">
                <Icon className="nav-icon" size={18} strokeWidth={2.2} aria-hidden="true" />
                <span>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <div class="sidebar-footer">
          {mpConfig.managedAdminCta.visible && (
            managedAdminCtaHref ? (
              <a
                href={managedAdminCtaHref}
                target="_blank"
                rel="noopener noreferrer"
                class="line-consultation"
                data-mp-admin-cta
              >
                {mpConfig.managedAdminCta.eyebrow && (
                  <span class="line-badge">{mpConfig.managedAdminCta.eyebrow}</span>
                )}
                <span class="line-main">
                  {mpConfig.managedAdminCta.badge && (
                    <span class="line-icon" aria-hidden="true">{mpConfig.managedAdminCta.badge}</span>
                  )}
                  <span class="line-cta">{mpConfig.managedAdminCta.text}</span>
                </span>
              </a>
            ) : (
              <div class="line-consultation line-consultation-static" aria-disabled="true">
              {mpConfig.managedAdminCta.eyebrow && (
                <span class="line-badge">{mpConfig.managedAdminCta.eyebrow}</span>
              )}
              <span class="line-main">
                {mpConfig.managedAdminCta.badge && (
                  <span class="line-icon" aria-hidden="true">{mpConfig.managedAdminCta.badge}</span>
                )}
                <span class="line-cta">{mpConfig.managedAdminCta.text}</span>
              </span>
              </div>
            )
          )}
          <div class={`sidebar-version ${mpConfig.managedAdminCta.visible ? '' : 'sidebar-version-alone'}`}>
            <span class="sidebar-version-label">現在のバージョン</span>
            <a href="/admin/update" class="sidebar-version-link">v{CURRENT_VERSION}</a>
          </div>
        </div>
      </aside>

      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>

  <AdminToast client:load />

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
    const close = document.querySelector<HTMLButtonElement>('[data-sidebar-close]');
    const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
    const backdrop = document.querySelector<HTMLElement>('[data-sidebar-backdrop]');
    const accountMenu = document.querySelector<HTMLElement>('[data-account-menu]');
    const accountTrigger = document.querySelector<HTMLButtonElement>('[data-account-trigger]');
    const accountPopover = document.querySelector<HTMLElement>('[data-account-popover]');
    const mobileQuery = window.matchMedia('(max-width: 768px)');
    let sidebarOpen = false;
    let accountOpen = false;

    function syncSidebarAccessibility(open: boolean) {
      if (!sidebar) return;
      const hidden = mobileQuery.matches && !open;
      sidebar.toggleAttribute('inert', hidden);
      sidebar.setAttribute('aria-hidden', hidden ? 'true' : 'false');
    }

    function setOpen(open: boolean) {
      if (!toggle || !sidebar || !backdrop) return;
      sidebarOpen = open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
      if (close) {
        close.disabled = !open;
        close.tabIndex = open ? 0 : -1;
        close.setAttribute('aria-hidden', open ? 'false' : 'true');
      }
      syncSidebarAccessibility(open);
      sidebar.classList.toggle('is-open', open);
      backdrop.classList.toggle('is-open', open);
      document.body.classList.toggle('sidebar-open', open);
    }

    function setAccountOpen(open: boolean) {
      if (!accountTrigger || !accountPopover) return;
      accountOpen = open;
      accountTrigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      accountTrigger.setAttribute(
        'aria-label',
        open ? 'アカウントメニューを閉じる' : 'アカウントメニューを開く'
      );
      accountPopover.hidden = !open;
      accountMenu?.classList.toggle('is-open', open);
    }

    toggle?.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      setOpen(open);
    });

    accountTrigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      setAccountOpen(accountTrigger.getAttribute('aria-expanded') !== 'true');
    });

    backdrop?.addEventListener('click', () => setOpen(false));
    close?.addEventListener('click', () => setOpen(false));

    sidebar?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('click', (e) => {
      if (accountOpen && accountMenu && !accountMenu.contains(e.target as Node)) {
        setAccountOpen(false);
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        setOpen(false);
        setAccountOpen(false);
      }
    });

    mobileQuery.addEventListener('change', () => {
      if (!mobileQuery.matches) {
        setOpen(false);
        return;
      }
      syncSidebarAccessibility(sidebarOpen);
    });

    setOpen(false);
    setAccountOpen(false);
  </script>

  <script>
    type ManagedProviderEventType =
      | 'provider_link_impression'
      | 'provider_link_click'
      | 'managed_admin_cta_impression'
      | 'managed_admin_cta_click';

    function buildMpEventPayload(eventType: ManagedProviderEventType) {
      return JSON.stringify({ event_type: eventType, occurred_at: new Date().toISOString() });
    }

    function sendMpEvent(eventType: ManagedProviderEventType) {
      const payload = buildMpEventPayload(eventType);
      if (navigator.sendBeacon) {
        navigator.sendBeacon(
          '/api/managed-provider/usage',
          new Blob([payload], { type: 'application/json' })
        );
        return;
      }

      fetch('/api/managed-provider/usage', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: payload,
        keepalive: true,
      }).catch(() => {});
    }

    const providerLink = document.querySelector('[data-mp-provider-link]');
    const adminCta = document.querySelector('[data-mp-admin-cta]');

    if (providerLink) {
      sendMpEvent('provider_link_impression');
      providerLink.addEventListener('click', () => sendMpEvent('provider_link_click'));
    }

    if (adminCta) {
      sendMpEvent('managed_admin_cta_impression');
      adminCta.addEventListener('click', () => sendMpEvent('managed_admin_cta_click'));
    }
  </script>
</body>
</html>

<style is:global>
  /* Layout-specific overrides on top of Tailwind's preflight.
     Don't add a `*` reset or generic `a` reset here — those would be
     unlayered and would beat every Tailwind utility (margin / padding /
     color), which is exactly what bit us on the first islands. */
  :root {
    --admin-page-bg: linear-gradient(135deg, #f8f9fc 0%, #f1f4fa 48%, #f6f7fb 100%);
  }

  html {
    min-height: 100%;
    background: #f6f7fb;
  }

  body {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    font-family: -apple-system, BlinkMacSystemFont, 'Hiragino Kaku Gothic ProN',
      'Noto Sans JP', sans-serif;
    background: #f6f7fb;
    color: #3f4352;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--admin-page-bg);
  }

  .admin-layout {
    --admin-text-strong: #3f4352;
    --admin-text: #596173;
    --admin-text-muted: #7f8797;
    --admin-text-faint: #9aa1ae;
    --admin-accent: #567baf;
    --admin-accent-soft: rgba(86, 123, 175, 0.12);
    --admin-header-height: 64px;
  }

  .admin-layout a[href],
  .admin-layout button:not(:disabled),
  .admin-layout [role='button']:not([aria-disabled='true']) {
    cursor: pointer;
  }

  .admin-layout button:disabled,
  .admin-layout [aria-disabled='true'] {
    cursor: not-allowed;
  }

  .admin-layout .logo-current,
  .admin-layout .nav-item-current {
    cursor: default;
  }

  @media (max-width: 768px) {
    body.sidebar-open astro-dev-toolbar {
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
    }
  }

  .admin-layout .text-gray-900,
  .admin-layout .text-gray-800,
  .admin-layout .hover\:text-gray-900:hover {
    color: var(--admin-text-strong) !important;
  }

  .admin-layout .text-gray-700,
  .admin-layout .hover\:text-gray-700:hover {
    color: var(--admin-text) !important;
  }

  .admin-layout .text-gray-600 {
    color: var(--admin-text-muted) !important;
  }

  .admin-layout .text-gray-500,
  .admin-layout .text-gray-400 {
    color: var(--admin-text-faint) !important;
  }
</style>

<style>
  .admin-layout {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
    background: transparent;
  }

  /* Update banner — yellow for normal releases, red for [critical]
     ones flagged in the GitHub release title. */
  .update-banner {
    background: #fef3c7;
    border-bottom: 1px solid #fde68a;
    color: #78350f;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .update-banner-critical {
    background: #fee2e2;
    border-bottom: 1px solid #fca5a5;
    color: #7f1d1d;
  }

  .update-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
  }

  .update-text strong {
    color: #92400e;
  }

  .update-banner-critical .update-text strong {
    color: #991b1b;
  }

  .update-critical-label {
    background: #b91c1c;
    color: #ffffff !important;
    padding: 0.125rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    margin-right: 0.5rem;
  }

  .update-current {
    color: #a16207;
    font-size: 0.75rem;
    margin-left: 0.25rem;
  }

  .update-banner-critical .update-current {
    color: #b91c1c;
  }

  .update-button {
    background: #92400e;
    color: #ffffff;
    padding: 0.25rem 0.75rem;
    border-radius: 0.25rem;
    font-size: 0.8125rem;
    font-weight: 600;
    transition: background 0.15s;
  }

  .update-button:hover {
    background: #78350f;
  }

  .update-banner-critical .update-button {
    background: #b91c1c;
  }

  .update-banner-critical .update-button:hover {
    background: #991b1b;
  }

  /* Header */
  .admin-header {
    background: rgba(255, 255, 255, 0.72);
    border-bottom: 1px solid rgba(214, 220, 232, 0.62);
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--admin-header-height);
    position: sticky;
    top: 0;
    z-index: 45;
    backdrop-filter: saturate(1.25) blur(18px);
    box-shadow: 0 14px 36px rgba(31, 34, 48, 0.055);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 0.75rem);
    color: var(--admin-text-strong);
    min-width: 0;
  }

  .logo-link {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    line-height: 0;
    max-width: min(52vw, 280px);
  }

  .logo-image {
    display: block;
    max-width: 100%;
    width: auto;
    height: auto;
    max-height: min(42px, calc(var(--admin-header-height) - 20px));
  }

  a.logo-link:hover .logo-image {
    opacity: 0.82;
  }

  .logo-by {
    font-size: 0.75rem;
    color: var(--admin-text-muted);
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
  }

  .logo-by-link {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .logo-by-link:hover {
    color: var(--admin-accent);
  }

  .logo-by-link-static {
    cursor: default;
    text-decoration: none;
  }

  .logo-by-link-static:hover {
    color: inherit;
  }

  .header-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
  }

  .user-role {
    padding: 0.16rem 0.54rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .role-owner {
    background: #fef3c7;
    color: #92400e;
  }

  .role-editor {
    background: #dbeafe;
    color: #1e40af;
  }

  .logout-form {
    margin: 0;
  }

  .account-menu {
    position: relative;
  }

  .account-trigger {
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 999px;
    border: 0;
    background: transparent;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: none;
  }

  .account-avatar {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--admin-accent);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: 0;
    box-shadow: 0 12px 28px rgba(86, 123, 175, 0.2);
  }

  .account-popover {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    z-index: 45;
    width: min(320px, calc(100vw - 1.5rem));
    overflow: hidden;
    border: 1px solid rgba(214, 220, 232, 0.78);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(1.2) blur(18px);
    box-shadow: 0 24px 58px rgba(31, 34, 48, 0.17);
  }

  .account-summary {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    border-bottom: 1px solid rgba(214, 220, 232, 0.68);
  }

  .account-email {
    max-width: 100%;
    color: var(--admin-text-strong);
    font-size: 1.05rem;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .account-menu-item {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--admin-text-strong);
    display: flex;
    align-items: center;
    padding: 1rem 1.25rem;
    text-align: left;
    font-size: 0.98rem;
    font-weight: 700;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .account-menu-item:hover {
    background: rgba(86, 123, 175, 0.08);
    color: var(--admin-accent);
  }

  /* Body layout */
  .admin-body {
    display: flex;
    flex: 1;
    min-height: calc(100vh - var(--admin-header-height));
    min-height: calc(100dvh - var(--admin-header-height));
  }

  /* Sidebar — sticks to the viewport top so navigation is always
     reachable, regardless of how tall the LP edit screen scrolls. */
  .admin-sidebar {
    width: 256px;
    background: rgba(255, 255, 255, 0.74);
    border: 1px solid rgba(214, 220, 232, 0.68);
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    padding: 1.25rem 1rem 1.1rem;
    position: sticky;
    /* Sit directly under the sticky header (height: 56px) so the LINE
       consultation button at the bottom of the sidebar lands on the
       viewport floor, not below it. */
    top: calc(var(--admin-header-height) + 1rem);
    align-self: flex-start;
    height: calc(100vh - var(--admin-header-height) - 2rem);
    margin: 1rem 0 1rem 1rem;
    overflow-y: auto;
    backdrop-filter: saturate(1.2) blur(18px);
    box-shadow: 0 18px 42px rgba(31, 34, 48, 0.07);
  }

  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.72rem 0.9rem;
    color: var(--admin-text);
    font-size: 0.9375rem;
    border-radius: 999px;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    will-change: transform;
  }

  .nav-icon {
    flex: 0 0 auto;
    color: var(--admin-text-faint);
  }

  .nav-item:hover {
    background: rgba(86, 123, 175, 0.07);
    color: var(--admin-accent);
    transform: translateX(2px);
  }

  .nav-item:hover .nav-icon,
  .nav-item-current .nav-icon {
    color: currentColor;
  }

  /* Render the current page's nav entry as a non-interactive label so a
     repeat tap on it doesn't reload the same page. */
  .nav-item-current {
    background: var(--admin-accent);
    color: #ffffff;
    font-weight: 600;
    cursor: default;
    box-shadow: 0 10px 24px rgba(86, 123, 175, 0.22);
  }

  .nav-item-current:hover {
    background: var(--admin-accent);
    color: #ffffff;
    transform: none;
  }

  .logo-current {
