---
/**
 * LPRenderer
 *
 * Renders an LP from its parsed content. Used by both the root page
 * (/) and dynamic slug pages (/[slug]).
 *
 * Layout strategy:
 * - Sections stack vertically at the LP's max width.
 * - Each section is `position: relative`; the image fills 100% width
 *   and the section preserves its aspect ratio so the absolutely-
 *   positioned CTAs stay anchored to the correct spot regardless of
 *   viewport width.
 * - CTAs are positioned with x/y as percentages of the section box.
 *   Width and height are both interpreted against the LP width, so
 *   button proportions do not change with the section image ratio.
 *
 * Webhook CTAs render as inert buttons.
 */

import type { PageContent, Cta, CtaLink } from '../lib/content';
import {
  resolveCtaTemplate,
  CTA_ICON_SVGS,
} from '../lib/cta-template';
// modern-normalize: well-known, ~2KB CSS reset that smooths out
// browser defaults consistently. Imported at this layer so it ships
// with every route that renders an LP — including the admin preview
// iframe which doesn't otherwise pull in Tailwind preflight.
import 'modern-normalize/modern-normalize.css';

/**
 * Stable LP-identity triple that the public HTML advertises via
 * `data-ilpb-*` attributes. Optional: the editor preview / admin
 * preview / unpublished routes don't have a publication_id, so they
 * omit the prop and the renderer skips every `data-ilpb-*` attr
 * (root, per-section, and per-CTA) — partial identifiers would be
 * worse than none, so all attrs are gated on this prop together.
 */
interface ConnectorContext {
  lpId: string;
  versionId: string;
  publicationId: string;
}

interface Props {
  content: PageContent;
  /**
   * Map of MyLink id -> resolved URL. CTAs whose link.myLinkId is
   * present here will use that URL instead of the inline value.
   * Pass an empty Map (or omit) when MyLinks aren't relevant.
   */
  myLinkUrls?: Map<string, string>;
  /**
   * When set, the renderer attaches `data-ilpb-lp-id` /
   * `-version-id` / `-publication-id` to the LP root, and per-index
   * identifiers to each section / CTA. The Hub Connector script
   * picks these up to associate inbound events with the right LP.
   */
  connectorContext?: ConnectorContext;
  /**
   * Public LP body width in px. CTA saved heights are percentages of
   * this width, so text buttons use it to keep the saved height as a
   * responsive minimum while still growing for wrapped copy.
   */
  maxWidth?: number;
}

const { content, myLinkUrls, connectorContext, maxWidth = 640 } = Astro.props;
const rendererMaxWidth = Math.max(
  320,
  Math.min(1920, Math.round(Number(maxWidth) || 640)),
);

const HEX_COLOR = /^#[0-9a-fA-F]{3,8}$/;

function safeColor(value: string, fallback: string): string {
  return HEX_COLOR.test(value) ? value : fallback;
}

type CtaTarget =
  | { kind: 'link'; href: string; external: boolean }
  | { kind: 'inert' };

function resolveUrl(link: { url: string; myLinkId?: string }): string {
  if (link.myLinkId && myLinkUrls) {
    const resolved = myLinkUrls.get(link.myLinkId);
    if (resolved) return resolved;
  }
  return link.url;
}

function isExternalBrowserHref(href: string): boolean {
  return /^https?:\/\//i.test(href);
}

function ctaTarget(link: CtaLink): CtaTarget {
  switch (link.type) {
    case 'line_friend': {
      const href = resolveUrl(link);
      return {
        kind: 'link',
        href,
        external: isExternalBrowserHref(href),
      };
    }
    case 'custom_url': {
      const href = resolveUrl(link);
      return {
        kind: 'link',
        href,
        external: isExternalBrowserHref(href),
      };
    }
    case 'tel':
      return { kind: 'link', href: `tel:${link.number}`, external: false };
    case 'mailto':
      return { kind: 'link', href: `mailto:${link.email}`, external: false };
    case 'webhook':
      return { kind: 'inert' };
  }
}

function ctaMinHeightStyle(boxHeightPercent: number): string {
  const maxPx = Number(
    ((boxHeightPercent / 100) * rendererMaxWidth).toFixed(3),
  );
  return `clamp(44px, ${boxHeightPercent}vw, ${maxPx}px)`;
}

function ctaStyle(cta: Cta): string {
  const bg = safeColor(cta.style.backgroundColor, '#000000');
  const fg = safeColor(cta.style.textColor, '#ffffff');
  const radius = Math.max(0, Number(cta.style.borderRadius) || 0);
  const renderMode = cta.buttonMode ?? (cta.image ? 'image' : 'text');
  // For image-backed CTAs, the box itself is transparent — the image
  // does the visual work — so we drop the background fill and the
  // border radius (the image's own shape is the source of truth).
  const hasImage = renderMode === 'image' && !!cta.image;
  // Templates contribute gradient / outline / bottom-border / shadow
  // on top of the base colors. resolveCtaTemplate handles the colour
  // math so the user can change backgroundColor and the gradient
  // updates with it.
  const deco = hasImage ? null : resolveCtaTemplate(cta);
  const iconSvg = deco?.iconLeft ? CTA_ICON_SVGS[deco.iconLeft] : undefined;
  const iconOnRight = iconSvg && deco?.iconPosition === 'right';
  const iconPad = iconSvg
    ? ctaIconPaddingStyle(cta, deco?.iconCircleColor, deco?.iconSize)
    : '';
  const iconOffset = iconSvg
    ? ctaIconOffsetStyle(cta, deco?.iconCircleColor, deco?.iconSize)
    : '';
  const boxHeight = Math.max(0.1, Number(cta.size.height) || 10);
  const boxHeightStyle = ctaMinHeightStyle(boxHeight);
  // Font size is applied to the inner .lp-cta-text via ctaTextStyle()
  // so it can use container query units for the responsive shrink.
  return [
    `left:${cta.position.x}%`,
    hasImage
      ? `top:${cta.position.y}%`
      : `bottom:max(0px, calc(100% - ${cta.position.y}% - ${boxHeightStyle}))`,
    `width:${cta.size.width}%`,
    hasImage
      ? `aspect-ratio:${cta.size.width} / ${boxHeight}`
      : `min-height:${boxHeightStyle}`,
    hasImage
      ? 'background:transparent'
      : `background:${deco ? deco.background : bg}`,
    `color:${fg}`,
    hasImage ? '' : `border-radius:${radius}px`,
    hasImage ? 'padding:0' : '',
    !hasImage && iconSvg && !iconOnRight ? `padding-left:${iconPad}` : '',
    !hasImage && iconSvg && iconOnRight ? `padding-right:${iconPad}` : '',
    !hasImage && iconSvg ? `--cta-icon-offset:${iconOffset}` : '',
    !hasImage && deco?.borderColor
      ? `border:${deco.borderWidth ?? 1}px solid ${deco.borderColor}`
      : '',
    !hasImage && deco?.boxShadow ? `box-shadow:${deco.boxShadow}` : '',
  ]
    .filter(Boolean)
    .join(';');
}

/**
 * Inline style for the text node inside a CTA. The text scales in
 * lockstep with the CTA box itself by using container-query width
 * units (`cqw`) — so a button that shrinks to half the size shows
 * text at half the size too, no abrupt floor.
 *
 * The clamp() bounds are intentionally generous — they only kick in
 * to keep the text from going invisibly small or absurdly large.
 *
 * - User-set fontSize N → preferred = (N/4) cqw (at 400px CTA width
 *                         the font hits N px exactly), floor 8px,
 *                         ceiling = 3 × N px so the text can grow
 *                         on wider CTAs at the same ratio.
 * - Unset              → anchor at 28px on a 400px CTA, same shape.
 */
function ctaTextStyle(cta: Cta): string {
  return ctaFontStyle(cta.style.fontSize, 28);
}

function ctaSubTextStyle(cta: Cta): string {
  // Default anchor 18 — subText is the supplementary lead-in stacked
  // above the main label (e.g. "今だけ特典" / "お電話はこちら"). Going
  // smaller than the 28 px main default keeps the visual hierarchy
  // intact when the operator hasn't customised the size.
  return [
    ctaFontStyle(cta.style.subTextFontSize, 18),
    `color:${safeColor(cta.style.subTextColor ?? cta.style.textColor, cta.style.textColor)}`,
  ].join(';');
}

function ctaIconStyle(cta: Cta, resolvedIconSize?: number): string {
  const size = cta.style.iconSize ?? resolvedIconSize ?? 18;
  return `${Math.max(8, Math.min(64, size))}px`;
}

function ctaIconPaddingStyle(
  cta: Cta,
  iconCircleColor: string | undefined,
  resolvedIconSize?: number,
): string {
  const size = Math.max(8, Math.min(64, cta.style.iconSize ?? resolvedIconSize ?? 18));
  const preferred = Math.round(size * (iconCircleColor ? 1.35 : 1.08) + 12);
  const min = Math.max(20, Math.round(size * 0.9 + 8));
  const fluid = Math.round(size * 0.9 + 6);
  return `clamp(${min}px, calc(${fluid}px + 1vw), ${preferred}px)`;
}

function ctaIconOffsetStyle(
  cta: Cta,
  iconCircleColor: string | undefined,
  resolvedIconSize?: number,
): string {
  const size = Math.max(8, Math.min(64, cta.style.iconSize ?? resolvedIconSize ?? 18));
  const radius = Math.max(0, Number(cta.style.borderRadius) || 0);
  const radiusBoost = Math.min(14, Math.round(radius * 0.16));
  const circleBoost = iconCircleColor ? 4 : 0;
  const min = Math.round(size * 0.45 + 8 + circleBoost);
  const max = min + radiusBoost + 10;
  return `clamp(${min}px, calc(${min}px + 0.8vw), ${max}px)`;
}

function ctaFontStyle(set: number | undefined, defaultAnchor: number): string {
  const anchor = typeof set === 'number' && set > 0 ? Math.max(8, set) : defaultAnchor;
  const cqw = +(anchor / 4).toFixed(2);
  const ceil = anchor * 3;
  return `font-size: clamp(8px, ${cqw}cqw, ${ceil}px);`;
}
---

<div
  class="lp"
  data-ilpb-lp-id={connectorContext?.lpId}
  data-ilpb-version-id={connectorContext?.versionId}
  data-ilpb-publication-id={connectorContext?.publicationId}
>
  {content.sections.map((section, sectionIndex) => {
    const aspect = `${section.image.width} / ${section.image.height}`;
    return (
      <section
        class="lp-section"
        style={`aspect-ratio: ${aspect}`}
        data-ilpb-section-id={connectorContext ? section.id : undefined}
        data-ilpb-section-index={connectorContext ? sectionIndex : undefined}
      >
        <img
          src={section.image.url}
          alt={section.image.alt ?? ''}
          width={section.image.width}
          height={section.image.height}
          loading="lazy"
          decoding="async"
          class="lp-image"
        />
        {section.ctas.map((cta, ctaIndex) => {
          const target = ctaTarget(cta.link);
          const style = ctaStyle(cta);
          const renderMode = cta.buttonMode ?? (cta.image ? 'image' : 'text');
          const hasImage = renderMode === 'image' && !!cta.image;
          const animClass =
            cta.animation && cta.animation !== 'none'
              ? `cta-anim-${cta.animation}`
              : '';
          // Template extras for non-image CTAs: optional icon and second
          // line of text (phone template).
          const deco = !hasImage ? resolveCtaTemplate(cta) : null;
          const iconSvg = deco?.iconLeft
            ? CTA_ICON_SVGS[deco.iconLeft]
            : undefined;
          const iconOnRight = iconSvg && deco?.iconPosition === 'right';
          const subText = cta.style.subText;
          const inner = hasImage ? (
            <img
              src={cta.image!.url}
              alt={cta.text}
              width={cta.image!.width}
              height={cta.image!.height}
              loading="lazy"
              decoding="async"
              class="lp-cta-image"
            />
          ) : (
            <>
              {iconSvg && (
                <span
                  class:list={[
                    'lp-cta-icon',
                    iconOnRight ? 'lp-cta-icon-right' : 'lp-cta-icon-left',
                    deco?.iconCircleColor && 'lp-cta-icon-circle',
                  ]}
                  style={[
                    `font-size:${ctaIconStyle(cta, deco?.iconSize)}`,
                    deco?.iconCircleColor ? `color:${deco.iconCircleColor}` : '',
                  ].filter(Boolean).join(';')}
                  aria-hidden="true"
                >
                  <svg
                    viewBox={`0 0 ${iconSvg.width} ${iconSvg.height}`}
                    preserveAspectRatio="xMidYMid meet"
                    fill="currentColor"
                  >
                    <path d={iconSvg.path} />
                  </svg>
                </span>
              )}
              <span class="lp-cta-text-wrap">
                {/* subText renders ABOVE the main label — used as a
                    lead-in like "今だけ特典" or for the bigger phone
                    number above "お電話はこちら". Operator can choose
                    its size independently from the main label. */}
                {subText && (
                  <span class="lp-cta-subtext" style={ctaSubTextStyle(cta)}>{subText}</span>
                )}
                <span class="lp-cta-text" style={ctaTextStyle(cta)}>{cta.text}</span>
              </span>
            </>
          );
          if (target.kind === 'link') {
            return (
              <a
                href={target.href}
                class:list={[
                  'lp-cta',
                  animClass,
                  hasImage ? 'lp-cta-has-image' : 'lp-cta-text-button',
                ]}
                style={style}
                data-ilpb-cta-id={connectorContext ? cta.id : undefined}
                data-ilpb-section-id={connectorContext ? section.id : undefined}
                data-ilpb-cta-index={connectorContext ? ctaIndex : undefined}
                {...(target.external && {
                  target: '_blank',
                  rel: 'noopener noreferrer',
                })}
              >
                {inner}
              </a>
            );
          }
          return (
            <button
              type="button"
              class:list={[
                'lp-cta',
                animClass,
                hasImage ? 'lp-cta-has-image' : 'lp-cta-text-button',
              ]}
              style={style}
              data-ilpb-cta-id={connectorContext ? cta.id : undefined}
              data-ilpb-section-id={connectorContext ? section.id : undefined}
              data-ilpb-cta-index={connectorContext ? ctaIndex : undefined}
              disabled
            >
              {inner}
            </button>
          );
        })}
      </section>
    );
  })}
</div>

<style is:global>
  /* Tiny LP-side additions on top of modern-normalize (imported via
     the Astro frontmatter). :where() keeps specificity at 0 so any
     Tailwind preflight / self-hoster custom CSS still wins on conflict.
  */
  :where(a) { color: inherit; text-decoration: none; }
  :where(img, svg, video, canvas, picture) {
    display: block;
    max-width: 100%;
    height: auto;
  }
  :where(ul, ol) { list-style: none; padding: 0; margin: 0; }
</style>

<style>
  .lp {
    width: 100%;
    margin: 0 auto;
    background: #ffffff;
  }

  .lp-section {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .lp-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .lp-cta {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    cursor: pointer;
    text-decoration: none;
    font-family: system-ui, -apple-system, 'Hiragino Sans', 'Yu Gothic',
      sans-serif;
    font-weight: bold;
    box-sizing: border-box;
    padding: 0 0.5em;
    line-height: 1.2;
    transition: transform 0.16s ease;
    /* Establish a containment context so the inner .lp-cta-text can
       use cqw units to scale font-size with the CTA's own width. */
    container-type: inline-size;
  }

  @media (hover: hover) and (pointer: fine) {
    .lp-cta:not(.cta-anim-pulse):not(.cta-anim-shake):not(.cta-anim-bounce):not(.cta-anim-glow):not(.cta-anim-fade):hover {
      transform: scale(1.018);
    }
  }

  .lp-cta:disabled {
    cursor: default;
  }

  .lp-cta-text-button {
    min-height: 44px;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
  }

  @media (min-width: 640px) {
    .lp-cta-text-button {
      min-height: 48px;
    }
  }

  .lp-cta-text {
    display: block;
    text-align: center;
    width: 100%;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    overflow-wrap: anywhere;
    line-break: strict;
  }

  /* Wraps the main text + optional subtext so they stack vertically
     inside templates like 電話 that use a two-line layout. */
  .lp-cta-text-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.2;
    flex: 1 1 auto;
    min-width: 0;
    width: 100%;
  }

  .lp-cta-subtext {
    display: block;
    letter-spacing: 0.02em;
    max-width: 100%;
    white-space: normal;
    overflow: visible;
    text-overflow: clip;
    overflow-wrap: anywhere;
    line-break: strict;
    /* subtext stacks above the main label, so the spacing knob is a
       bottom margin (gap to the label below it). 0.35em reads as a
       comfortable breath between the two lines without losing the
       feeling that they belong to the same button. */
    margin-bottom: 0.35em;
  }

  /* CTA icon. Sizes relative to the CTA so it scales with the button. */
  .lp-cta-icon {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15em;
    height: 1.15em;
    flex: 0 0 auto;
    color: currentColor;
    line-height: 0;
  }
  .lp-cta-icon-left {
    left: var(--cta-icon-offset, 0.8em);
  }
  .lp-cta-icon-right {
    right: var(--cta-icon-offset, 0.8em);
  }
  .lp-cta-icon svg {
    display: block;
    width: 1em;
    height: 1em;
  }
  .lp-cta-icon-circle {
    width: 1.55em;
    height: 1.55em;
    border-radius: 9999px;
    background: #ffffff;
  }
  .lp-cta-icon-circle svg {
    width: 0.78em;
    height: 0.78em;
  }

  /* Image-backed CTAs: the <a>/<button> box is just a hit target;
     the image itself fills it preserving aspect ratio. */
  .lp-cta-has-image {
    overflow: hidden;
  }
  .lp-cta-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
  }

  /* CTA animations live in src/styles/global.css (cta-anim-*) so the
     editor preview and the public LP share the same definitions. */
</style>
